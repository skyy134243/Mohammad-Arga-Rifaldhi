    <!-- SCRIPT APPLICATION METODE FETCH API (MOCKAPI.IO) -->
    <script>
        (() => {
            'use strict';
            
            // ENDPOINT BASE URL MOCKAPI ANDA (SUDAH DIPASANG PRESISI)
            const API_BASE_URL = 'https://6a8e9a1aa12b7de8cc0ec0ef.mockapi.io/laporkita/api';
            const SESSION_KEY = 'laporkita_session';
            const FIXED_OFFICER_CODE = '3826252718';

            // UTILITY FETCHERS METODE API
            async function fetchUsers() {
                try {
                    const res = await fetch(`${API_BASE_URL}/users`);
                    if (!res.ok) return [];
                    return await res.json();
                } catch(e) {
                    console.error("Gagal mengambil data user:", e);
                    return [];
                }
            }

            async function fetchReports() {
                try {
                    const res = await fetch(`${API_BASE_URL}/reports`);
                    if (!res.ok) return [];
                    const data = await res.json();
                    return data.reverse(); // Urutkan laporan dari terbaru
                } catch(e) {
                    console.error("Gagal mengambil data laporan:", e);
                    return [];
                }
            }

            // FETCH PETUNJUK (PETUNJUK PENCARIAN WARGA)
            async function fetchClues() {
                try {
                    const res = await fetch(`${API_BASE_URL}/clues`);
                    if (!res.ok) return getLocalCluesFallback();
                    return await res.json();
                } catch(e) {
                    return getLocalCluesFallback();
                }
            }

            function getLocalCluesFallback() {
                try {
                    return JSON.parse(localStorage.getItem('laporkita_clues_fallback') || '[]');
                } catch(e) { return []; }
            }

            async function saveClue(clueData) {
                try {
                    const res = await fetch(`${API_BASE_URL}/clues`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(clueData)
                    });
                    if (!res.ok) throw new Error();
                } catch(e) {
                    const local = getLocalCluesFallback();
                    local.unshift(clueData);
                    localStorage.setItem('laporkita_clues_fallback', JSON.stringify(local));
                }
            }

            function getSession() {
                try { const item = localStorage.getItem(SESSION_KEY); return item ? JSON.parse(item) : null; } catch(e) { return null; }
            }
            function setSession(val) {
                try { localStorage.setItem(SESSION_KEY, JSON.stringify(val)); } catch(e) {}
            }

            // SEED DEFAULT USERS JIKA DATABASE MASIH KOSONG
            async function seedDefaultUsers() {
                const users = await fetchUsers();
                if (users.length === 0) {
                    await fetch(`${API_BASE_URL}/users`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ fullname: 'Mohammad Arga', username: 'arga', email: 'arga@test.com', password: 'password123', role: 'warga' })
                    });
                    await fetch(`${API_BASE_URL}/users`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ fullname: 'Bripka Susanto (Satgas)', username: 'petugas', email: 'petugas@polri.go.id', password: 'password123', role: 'officer' })
                    });
                }
            }
            seedDefaultUsers();

            function navigateTo(targetId) {
                document.querySelectorAll('.page').forEach(p => p.style.display = 'none');
                const targetPage = document.getElementById(targetId) || document.getElementById('beranda');
                targetPage.style.display = 'block';

                document.querySelectorAll('#site-header nav a').forEach(a => {
                    if (a.getAttribute('data-target') === targetId) a.setAttribute('aria-current', 'page');
                    else a.removeAttribute('aria-current');
                });

                window.scrollTo(0, 0);
                renderAllData();
            }

            // MODAL & AUTH CONTROL
            const authModal = document.getElementById('auth-modal');
            const tabLoginBtn = document.getElementById('tab-btn-login');
            const tabOfficerBtn = document.getElementById('tab-btn-officer');
            const tabRegBtn = document.getElementById('tab-btn-register');
            
            const formLogin = document.getElementById('form-login');
            const formLoginOfficer = document.getElementById('form-login-officer');
            const formRegister = document.getElementById('form-register');

            function openModal() {
                authModal.style.display = 'flex';
                document.body.classList.add('modal-open');
            }

            function closeModal() {
                authModal.style.display = 'none';
                document.body.classList.remove('modal-open');
            }

            tabLoginBtn.addEventListener('click', () => {
                tabLoginBtn.classList.add('active'); tabOfficerBtn.classList.remove('active'); tabRegBtn.classList.remove('active');
                formLogin.style.display = 'block'; formLoginOfficer.style.display = 'none'; formRegister.style.display = 'none';
            });

            tabOfficerBtn.addEventListener('click', () => {
                tabOfficerBtn.classList.add('active'); tabLoginBtn.classList.remove('active'); tabRegBtn.classList.remove('active');
                formLoginOfficer.style.display = 'block'; formLogin.style.display = 'none'; formRegister.style.display = 'none';
            });

            tabRegBtn.addEventListener('click', () => {
                tabRegBtn.classList.add('active'); tabLoginBtn.classList.remove('active'); tabOfficerBtn.classList.remove('active');
                formRegister.style.display = 'block'; formLogin.style.display = 'none'; formLoginOfficer.style.display = 'none';
            });

            document.getElementById('btn-close-modal').addEventListener('click', closeModal);
            authModal.addEventListener('click', (e) => { if (e.target === authModal) closeModal(); });

            // MODAL PETUNJUK & NOTIFIKASI
            const clueModal = document.getElementById('clue-modal');
            const notificationsModal = document.getElementById('notifications-modal');

            window.openClueModal = function(reportId, reportTitle) {
                document.getElementById('clue-report-id').value = reportId;
                document.getElementById('clue-report-title').value = reportTitle;
                document.getElementById('clue-display-target').value = reportTitle;
                
                const session = getSession();
                if (session) {
                    document.getElementById('clue-informant').value = `${session.fullname} (${session.email})`;
                }

                clueModal.style.display = 'flex';
                document.body.classList.add('modal-open');
            };

            document.getElementById('btn-close-clue-modal').addEventListener('click', () => {
                clueModal.style.display = 'none';
                document.body.classList.remove('modal-open');
            });

            document.getElementById('btn-open-notifications').addEventListener('click', () => {
                notificationsModal.style.display = 'flex';
                document.body.classList.add('modal-open');
            });

            document.getElementById('btn-close-notif-modal').addEventListener('click', () => {
                notificationsModal.style.display = 'none';
                document.body.classList.remove('modal-open');
            });

            // SUBMIT PETUNJUK DARI WARGA
            document.getElementById('form-submit-clue').addEventListener('submit', async function(e) {
                e.preventDefault();
                const btn = document.getElementById('btn-send-clue-submit');
                btn.disabled = true;
                btn.textContent = '⏳ Mengirim...';

                const newClue = {
                    id: Date.now().toString(),
                    reportId: document.getElementById('clue-report-id').value,
                    reportTitle: document.getElementById('clue-report-title').value,
                    informant: document.getElementById('clue-informant').value,
                    location: document.getElementById('clue-location').value,
                    text: document.getElementById('clue-text').value,
                    createdAt: new Date().toLocaleString()
                };

                await saveClue(newClue);
                btn.disabled = false;
                btn.textContent = '🚀 Kirim Petunjuk ke Petugas';
                this.reset();
                clueModal.style.display = 'none';
                document.body.classList.remove('modal-open');

                alert(' Terimakasih! Petunjuk Anda telah terkirim langsung ke Panel Petugas Wilayah.');
                renderAllData();
            });

            // REGISTER AKUN VIA API
            formRegister.addEventListener('submit', async (e) => {
                e.preventDefault();
                const pass = document.getElementById('reg-password').value;
                const confirmPass = document.getElementById('reg-confirm').value;

                if (pass !== confirmPass) { alert('Konfirmasi kata sandi tidak cocok!'); return; }

                const users = await fetchUsers();
                const email = document.getElementById('reg-email').value.trim();
                const username = document.getElementById('reg-username').value.trim();

                if (users.find(u => u.email === email || u.username === username)) {
                    alert('Email atau Username ini sudah terdaftar!');
                    return;
                }

                const newUser = {
                    fullname: document.getElementById('reg-fullname').value,
                    username: username,
                    email: email,
                    password: pass,
                    role: document.getElementById('reg-role').value
                };

                const res = await fetch(`${API_BASE_URL}/users`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(newUser)
                });

                if (res.ok) {
                    const savedUser = await res.json();
                    if (newUser.role === 'officer') {
                        alert('Pendaftaran Akun Petugas Berhasil! Silakan masuk melalui tab Login Petugas.');
                        tabOfficerBtn.click();
                    } else {
                        setSession(savedUser);
                        alert('Pendaftaran akun warga berhasil! Anda otomatis masuk.');
                        closeModal();
                        formRegister.reset();
                        updateAuthUI();
                        navigateTo('akun-masyarakat');
                    }
                } else {
                    alert('Gagal mendaftar. Silakan coba lagi.');
                }
            });

            // LOGIN WARGA VIA API
            formLogin.addEventListener('submit', async (e) => {
                e.preventDefault();
                const inputId = document.getElementById('login-email').value.trim();
                const pass = document.getElementById('login-password').value;
                const users = await fetchUsers();

                const user = users.find(u => (u.email === inputId || u.username === inputId) && u.password === pass);
                if (user) {
                    if (user.role === 'officer') {
                        alert('Akun ini terdaftar sebagai Petugas. Silakan masuk melalui tab "Login Petugas"!');
                        tabOfficerBtn.click();
                        return;
                    }
                    setSession(user);
                    alert(`Selamat datang kembali, ${user.fullname}!`);
                    closeModal();
                    formLogin.reset();
                    updateAuthUI();
                    navigateTo('akun-masyarakat');
                } else {
                    alert('Email/Username atau Kata Sandi salah!');
                }
            });

            // LOGIN PETUGAS VIA API
            formLoginOfficer.addEventListener('submit', async (e) => {
                e.preventDefault();
                const inputId = document.getElementById('officer-email').value.trim();
                const pass = document.getElementById('officer-password').value;
                const code = document.getElementById('officer-code').value.trim();

                if (code !== FIXED_OFFICER_CODE) {
                    alert('Kode Verifikasi Petugas salah!');
                    return;
                }

                const users = await fetchUsers();
                const user = users.find(u => (u.email === inputId || u.username === inputId) && u.password === pass);
                if (user) {
                    if (user.role !== 'officer') {
                        alert('Akun ini bukan akun Petugas! Silakan login di tab Login Warga.');
                        return;
                    }
                    setSession(user);
                    alert(`Verifikasi Petugas Berhasil. Selamat bertugas, ${user.fullname}!`);
                    closeModal();
                    formLoginOfficer.reset();
                    updateAuthUI();
                    navigateTo('dasbor-petugas');
                } else {
                    alert('Email/Username Petugas atau Kata Sandi salah!');
                }
            });

            function updateAuthUI() {
                const session = getSession();
                const authHeaderAction = document.getElementById('auth-header-action');
                const citizenNav = document.getElementById('nav-item-citizen-dash');
                const officerNav = document.getElementById('nav-item-officer-dash');

                if (session) {
                    authHeaderAction.innerHTML = `
                        <span style="font-weight:700; font-size:0.85rem; color:var(--color-primary); margin-right:0.4rem;">👤 ${session.fullname} (${session.role === 'officer' ? 'Petugas' : 'Warga'})</span>
                        <button type="button" id="btn-logout" class="btn-secondary btn-sm">Keluar</button>
                    `;
                    citizenNav.style.display = session.role === 'warga' ? 'inline-block' : 'none';
                    officerNav.style.display = session.role === 'officer' ? 'inline-block' : 'none';

                    document.getElementById('btn-logout').addEventListener('click', () => {
                        localStorage.removeItem(SESSION_KEY);
                        alert('Anda telah keluar akun.');
                        updateAuthUI();
                        navigateTo('beranda');
                    });
                } else {
                    authHeaderAction.innerHTML = `
                        <button type="button" id="btn-open-auth-nav" class="btn-secondary btn-sm">Masuk / Daftar Akun</button>
                    `;
                    citizenNav.style.display = 'none';
                    officerNav.style.display = 'none';
                    document.getElementById('btn-open-auth-nav').addEventListener('click', openModal);
                }
            }

            // GPS & FOTO PREVIEW
            document.getElementById('btn-get-gps').addEventListener('click', () => {
                const inputGps = document.getElementById('report-gps');
                inputGps.value = "Mendeteksi...";
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                        (p) => inputGps.value = `${p.coords.latitude.toFixed(5)}, ${p.coords.longitude.toFixed(5)}`,
                        () => inputGps.value = "-6.91746, 107.61912 (GPS Default)"
                    );
                } else inputGps.value = "-6.91746, 107.61912 (GPS Default)";
            });

            const photoInput = document.getElementById('report-photo');
            const photoPreview = document.getElementById('photo-preview');
            photoInput.addEventListener('change', () => {
                const file = photoInput.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (e) => { photoPreview.src = e.target.result; photoPreview.style.display = 'block'; };
                    reader.readAsDataURL(file);
                }
            });

            // TERIMA LAPORAN VIA API (POST) (FITUR NOTIFIKASI MASSAL OTOMATIS)
            document.getElementById('main-report-form').addEventListener('submit', async function(e) {
                e.preventDefault();
                const session = getSession();

                if (!session) {
                    alert('Anda harus Masuk / Membuat Akun terlebih dahulu sebelum mengirimkan laporan!');
                    openModal();
                    return;
                }

                const submitBtn = document.getElementById('btn-submit-report');
                submitBtn.disabled = true;
                submitBtn.textContent = '⏳ Mengirim ke Server...';

                const isAnon = document.getElementById('is-anonymous').checked;
                const urgencyVal = document.querySelector('input[name="urgency"]:checked').value;
                const categoryVal = document.getElementById('report-category').value;
                const subcategoryVal = document.getElementById('report-subcategory').value || '-';

                const newReport = {
                    code: `LK-${Date.now().toString().slice(-6)}`,
                    category: categoryVal,
                    subcategory: subcategoryVal,
                    urgency: urgencyVal,
                    isAnonymous: isAnon,
                    reporterName: isAnon ? 'Warga Anonim' : session.fullname,
                    reporterEmail: session.email,
                    title: document.getElementById('report-title').value,
                    description: document.getElementById('report-description').value,
                    incidentDate: document.getElementById('incident-date').value || new Date().toLocaleString(),
                    gps: document.getElementById('report-gps').value || 'Tidak Ada Koordinat',
                    location: document.getElementById('location-name').value,
                    photo: photoPreview.src || '',
                    status: 'reported'
                };

                try {
                    const res = await fetch(`${API_BASE_URL}/reports`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(newReport)
                    });

                    if (res.ok) {
                        this.reset();
                        photoPreview.style.display = 'none';

                        // JIKA KATEGORI LAPORAN KEHILANGAN -> PICU BROADCAST MASSAL SEMUA PENGGUNA
                        if (categoryVal === 'Laporan Kehilangan') {
                            alert(`🚨 NOTIFIKASI MASSAL TERKIRIM KE SEMUA WARGA! Kasus ${subcategoryVal} ID: ${newReport.code} telah disiarkan agar semua masyarakat membantu pencarian & mengirimkan petunjuk ke petugas.`);
                        } else {
                            alert(`Laporan Pengaduan Terkirim secara Real-Time Online! Kode ID: ${newReport.code}`);
                        }
                        
                        navigateTo('laporan-terbaru');
                    } else {
                        alert('Gagal mengirim laporan. Pastikan koneksi internet terhubung.');
                    }
                } catch(err) {
                    alert('Terjadi kesalahan koneksi server.');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.textContent = '🚀 Kirim Laporan Pengaduan';
                }
            });

            // UPDATE STATUS LAPORAN VIA API (PUT)
            window.updateStatusReport = async function(id, newStatus) {
                try {
                    const res = await fetch(`${API_BASE_URL}/reports/${id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: newStatus })
                    });
                    if (res.ok) {
                        alert(`Status laporan berhasil diperbarui menjadi ${newStatus.toUpperCase()}`);
                        renderAllData();
                    }
                } catch(e) {
                    alert('Gagal mengupdate status.');
                }
            };

            // HAPUS LAPORAN VIA API (DELETE)
            window.deleteReport = async function(id) {
                if (confirm(`Apakah Anda yakin ingin menghapus laporan ini dari cloud server?`)) {
                    try {
                        const res = await fetch(`${API_BASE_URL}/reports/${id}`, { method: 'DELETE' });
                        if (res.ok) {
                            renderAllData();
                        }
                    } catch(e) {
                        alert('Gagal menghapus laporan.');
                    }
                }
            };

            // RENDER DATA METRIK, KARTU & PETUNJUK DARI CLOUD DATABASE
            async function renderAllData() {
                const reports = await fetchReports();
                const clues = await fetchClues();
                const session = getSession();

                // 0. CHECK NOTIFIKASI MASSAL KEHILANGAN
                const missingReports = reports.filter(r => r.category === 'Laporan Kehilangan');
                const notifCountEl = document.getElementById('notif-count');
                if (notifCountEl) notifCountEl.textContent = missingReports.length;

                const missingBanner = document.getElementById('missing-alert-banner');
                if (missingReports.length > 0 && missingBanner) {
                    const latestMissing = missingReports[0];
                    missingBanner.style.display = 'block';
                    document.getElementById('banner-text').textContent = `[${latestMissing.subcategory}] ${latestMissing.title} - Lokasi: ${latestMissing.location}. Mari bantu cari!`;
                    document.getElementById('btn-view-missing-alert').onclick = () => {
                        window.openClueModal(latestMissing.id, `${latestMissing.subcategory}: ${latestMissing.title}`);
                    };
                } else if (missingBanner) {
                    missingBanner.style.display = 'none';
                }

                // POPULATE NOTIFIKASI MODAL
                const notifModalList = document.getElementById('notif-modal-list');
                if (notifModalList) {
                    notifModalList.innerHTML = missingReports.length ? missingReports.map(r => `
                        <div style="padding:0.8rem; background:var(--color-surface-soft); border-radius:var(--radius-sm); border:1px solid #fde68a;">
                            <strong style="color:#b45309;">🚨 [${r.subcategory}] ${r.title}</strong>
                            <p style="font-size:0.85rem; margin:0.3rem 0;">${r.description}</p>
                            <small>📍 ${r.location} | Pelapor: ${r.reporterName}</small>
                            <div style="margin-top:0.5rem;">
                                <button type="button" onclick="openClueModal('${r.id}', '${r.title}')" class="btn-warning btn-sm">💡 Kirim Petunjuk ke Petugas</button>
                            </div>
                        </div>
                    `).join('') : '<p>Tidak ada pemberitahuan kehilangan saat ini.</p>';
                }

                // 1. STATISTIK ANGKA
                const total = reports.length;
                const pending = reports.filter(r => r.status === 'reported').length;
                const process = reports.filter(r => r.status === 'process').length;
                const completed = reports.filter(r => r.status === 'completed').length;
                const rate = total ? `${Math.round((completed / total) * 100)}%` : '0%';

                if (document.getElementById('stat-total')) {
                    document.getElementById('stat-total').textContent = total;
                    document.getElementById('stat-reported').textContent = pending;
                    document.getElementById('stat-process').textContent = process;
                    document.getElementById('stat-completed').textContent = completed;
                    document.getElementById('stat-rate').textContent = rate;
                }

                // 2. STATISTIK KATEGORI & URGENSI
                if (document.getElementById('halaman-statistik')) {
                    const countCat = (cat) => reports.filter(r => r.category === cat).length;
                    const catKehilangan = countCat('Laporan Kehilangan');
                    const catKec = countCat('Kecurangan & Program Publik');
                    const catFas = countCat('Fasilitas Publik');
                    const catPungli = countCat('Ketertiban & Pungli');
                    const catLing = countCat('Kebersihan & Lingkungan');
                    const catPel = countCat('Pelayanan Publik');

                    document.getElementById('count-cat-kehilangan').textContent = catKehilangan;
                    document.getElementById('count-cat-kecurangan').textContent = catKec;
                    document.getElementById('count-cat-fasilitas').textContent = catFas;
                    document.getElementById('count-cat-pungli').textContent = catPungli;
                    document.getElementById('count-cat-lingkungan').textContent = catLing;
                    document.getElementById('count-cat-pelayanan').textContent = catPel;

                    document.getElementById('bar-cat-kehilangan').style.width = total ? `${(catKehilangan/total)*100}%` : '0%';
                    document.getElementById('bar-cat-kecurangan').style.width = total ? `${(catKec/total)*100}%` : '0%';
                    document.getElementById('bar-cat-fasilitas').style.width = total ? `${(catFas/total)*100}%` : '0%';
                    document.getElementById('bar-cat-pungli').style.width = total ? `${(catPungli/total)*100}%` : '0%';
                    document.getElementById('bar-cat-lingkungan').style.width = total ? `${(catLing/total)*100}%` : '0%';
                    document.getElementById('bar-cat-pelayanan').style.width = total ? `${(catPel/total)*100}%` : '0%';

                    const countUrg = (u) => reports.filter(r => r.urgency === u).length;
                    const urgB = countUrg('Biasa');
                    const urgP = countUrg('Penting');
                    const urgD = countUrg('Darurat');

                    document.getElementById('count-urg-biasa').textContent = urgB;
                    document.getElementById('count-urg-penting').textContent = urgP;
                    document.getElementById('count-urg-darurat').textContent = urgD;

                    document.getElementById('bar-urg-biasa').style.width = total ? `${(urgB/total)*100}%` : '0%';
                    document.getElementById('bar-urg-penting').style.width = total ? `${(urgP/total)*100}%` : '0%';
                    document.getElementById('bar-urg-darurat').style.width = total ? `${(urgD/total)*100}%` : '0%';
                }

                // TEMPLATE LAPORAN UMUM
                const renderCard = (r) => {
                    let statusLabel = 'VERIFIKASI';
                    if (r.status === 'process') statusLabel = 'PROSES';
                    if (r.status === 'completed') statusLabel = 'SELESAI';

                    const isKehilangan = r.category === 'Laporan Kehilangan';

                    return `
                    <article class="report-card" ${isKehilangan ? 'style="border:2px solid #f59e0b;"' : ''}>
                        <header style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:0.5rem;">
                            <div>
                                <small style="color:var(--color-text-muted);">ID: ${r.code || r.id} | Pelapor: ${r.reporterName}</small>
                                <h3 style="margin-top:0.2rem;">${isKehilangan ? '🚨 ' : ''}${r.title}</h3>
                            </div>
                            <div>
                                ${isKehilangan ? '<span class="status badge-kehilangan">SEARCH & RESCUE</span>' : ''}
                                <span class="badge-urgency urgency-${r.urgency}">${r.urgency}</span>
                                <span class="status status-${r.status}">${statusLabel}</span>
                            </div>
                        </header>
                        <hr style="border:none; border-top:1px solid var(--color-border); margin:0.6rem 0;">
                        <p><strong>Kategori:</strong> ${r.category} (${r.subcategory})</p>
                        <p>${r.description}</p>
                        <p><small>📍 Lokasi: ${r.location} | GPS: ${r.gps}</small></p>
                        ${r.photo ? `<img src="${r.photo}" class="preview-img" style="display:block; margin-top:0.6rem;" alt="Foto Bukti">` : ''}
                        
                        ${isKehilangan ? `
                            <div class="clues-box">
                                <strong style="color:#b45309;">💡 Bantuan Warga (Petunjuk Pencarian)</strong>
                                <p style="font-size:0.8rem; color:var(--color-text-muted);">Punya informasi lokasi/ciri-ciri? Kirimkan ke petugas untuk membantu pencarian.</p>
                                <button type="button" onclick="openClueModal('${r.id}', '${r.subcategory}: ${r.title}')" class="btn-warning btn-sm" style="margin-top:0.5rem;">
                                    💡 Kirim Petunjuk Lokasi ke Petugas
                                </button>
                            </div>
                        ` : ''}
                    </article>`;
                };

                // TEMPLATE LAPORAN UNTUK PETUGAS
                const renderOfficerCard = (r) => `
                    <article class="report-card" style="border-left: 5px solid ${r.category === 'Laporan Kehilangan' ? '#f59e0b' : 'var(--color-primary)'};">
                        <header style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:0.5rem;">
                            <div>
                                <small style="color:var(--color-text-muted);">ID: ${r.code || r.id} | Pelapor: ${r.reporterName} (${r.reporterEmail})</small>
                                <h3 style="margin-top:0.2rem;">${r.title}</h3>
                            </div>
                            <div>
                                <span class="badge-urgency urgency-${r.urgency}">${r.urgency}</span>
                            </div>
                        </header>
                        <hr style="border:none; border-top:1px solid var(--color-border); margin:0.6rem 0;">
                        <p><strong>Kategori:</strong> ${r.category} | Sub: ${r.subcategory} | 📍 ${r.location} (${r.gps})</p>
                        <p>${r.description}</p>
                        ${r.photo ? `<img src="${r.photo}" class="preview-img" style="display:block; margin-top:0.6rem;" alt="Foto Bukti">` : ''}
                        
                        <div style="margin-top: 1rem; padding: 0.8rem; background: var(--color-surface-soft); border-radius: var(--radius-sm); display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
                            <label style="font-size:0.8rem;"><strong>Ubah Status Petugas:</strong></label>
                            <button type="button" onclick="updateStatusReport('${r.id}', 'reported')" class="btn-secondary btn-sm">Verifikasi</button>
                            <button type="button" onclick="updateStatusReport('${r.id}', 'process')" class="btn-secondary btn-sm" style="color:#0369a1;">Proses Tindak Lanjut</button>
                            <button type="button" onclick="updateStatusReport('${r.id}', 'completed')" class="btn-primary btn-sm">Selesaikan Laporan</button>
                            <button type="button" onclick="deleteReport('${r.id}')" class="btn-danger btn-sm" style="margin-left:auto;">Hapus</button>
                        </div>
                    </article>
                `;

                // Render ke DOM Laporan
                const homeList = document.getElementById('home-report-list');
                if (homeList) homeList.innerHTML = reports.length ? reports.slice(0, 4).map(renderCard).join('') : '<p>Belum ada laporan yang masuk.</p>';

                const allList = document.getElementById('all-reports-list');
                if (allList) allList.innerHTML = reports.length ? reports.map(renderCard).join('') : '<p>Belum ada laporan warga.</p>';

                const myList = document.getElementById('my-reports-list');
                if (myList && session && session.role === 'warga') {
                    const myReports = reports.filter(r => r.reporterEmail === session.email);
                    myList.innerHTML = myReports.length ? myReports.map(renderCard).join('') : '<p>Kamu belum memiliki riwayat pengaduan.</p>';
                }

                const officerList = document.getElementById('officer-reports-list');
                if (officerList && session && session.role === 'officer') {
                    officerList.innerHTML = reports.length ? reports.map(renderOfficerCard).join('') : '<p>Tidak ada pengaduan masuk di sistem.</p>';
                }

                // RENDER PETUNJUK MASUK DI DASBOR PETUGAS
                const officerCluesList = document.getElementById('officer-clues-list');
                if (officerCluesList && session && session.role === 'officer') {
                    officerCluesList.innerHTML = clues.length ? clues.map(c => `
                        <div class="clue-item">
                            <div style="display:flex; justify-content:space-between;">
                                <strong style="color:#b45309;">📌 Kasus: ${c.reportTitle}</strong>
                                <small style="color:var(--color-text-muted);">${c.createdAt}</small>
                            </div>
                            <p style="margin:0.2rem 0; font-size:0.9rem;"><strong>Petunjuk:</strong> ${c.text}</p>
                            <p style="margin:0; font-size:0.85rem;"><small>📍 Lokasi Dilihat: <strong>${c.location}</strong> | Pemberi Informasi: <strong>${c.informant}</strong></small></p>
                        </div>
                    `).join('') : '<p style="font-size:0.85rem; color:var(--color-text-muted);">Belum ada petunjuk masuk dari warga.</p>';
                }
            }

            // ROUTER EVENT & KATEGORI SELECT
            document.addEventListener('click', (e) => {
                const link = e.target.closest('.nav-link');
                if (link) {
                    e.preventDefault();
                    const target = link.getAttribute('data-target');

                    if (link.classList.contains('btn-category-select')) {
                        const cat = link.getAttribute('data-category');
                        const selectEl = document.getElementById('report-category');
                        if (selectEl && cat) {
                            selectEl.value = cat;
                            const subSelect = document.getElementById('report-subcategory');
                            if (cat === 'Laporan Kehilangan' && subSelect) {
                                subSelect.value = 'Kehilangan Orang';
                            }
                        }
                    }

                    navigateTo(target);
                }
            });

            // SINKRONISASI OTOMATIS SETIAP 4 DETIK (REAL-TIME AUTO REFRESH)
            setInterval(() => {
                const activePage = document.querySelector('.page[style*="display: block"]');
                if (activePage && activePage.id !== 'formulir-laporan') {
                    renderAllData();
                }
            }, 4000);

            // INIT
            updateAuthUI();
            navigateTo('beranda');
        })();
    </script>
</body>
</html>
