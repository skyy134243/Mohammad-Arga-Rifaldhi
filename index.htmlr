<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LAPORKITA - Platform Pengaduan & Dashboard Petugas</title>
    
    <style>
        :root {
            /* Palette Terinspirasi oleh PerfectDay.com (Organic Warm & Sustainable Greens) */
            --color-primary: #193e30;
            --color-primary-dark: #0f2920;
            --color-primary-light: #e6ede9;
            --color-accent-teal: #059669;
            --color-accent-teal-bg: #d1fae5;
            --color-accent-coral: #d95338;
            --color-accent-coral-bg: #fde8e4;
            --color-accent-amber: #d97706;
            --color-accent-amber-bg: #fef3c7;
            --color-background: #faf7f2; /* Color Background Utama Khas PerfectDay */
            --color-surface: #ffffff;
            --color-surface-soft: #f4efe6;
            --color-text: #1a231f;
            --color-text-secondary: #3b4841;
            --color-text-muted: #6b7a72;
            --color-border: #e6dfd3;
            --color-border-strong: #d4caba;
            --color-success: #10b981;
            --color-success-bg: #d1fae5;
            --color-warning: #f59e0b;
            --color-warning-bg: #fef3c7;
            --color-danger: #ef4444;
            --color-danger-bg: #fee2e2;
            --color-white: #ffffff;

            --shadow-sm: 0 4px 12px rgba(25, 62, 48, 0.04);
            --shadow-md: 0 12px 28px -4px rgba(25, 62, 48, 0.08);
            --shadow-lg: 0 24px 38px -6px rgba(15, 41, 32, 0.12);

            --radius-sm: 8px;
            --radius-md: 14px;
            --radius-lg: 20px;
            --radius-xl: 28px;

            --container-width: 1240px;
            --space-2: 0.5rem;
            --space-3: 0.75rem;
            --space-4: 1rem;
            --space-5: 1.25rem;
            --space-6: 1.5rem;
            --space-8: 2rem;
            --space-12: 3rem;
            --transition-fast: 180ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; font-size: 16px; }
        body, h1, h2, h3, h4, h5, h6, p, figure, ul, ol { margin: 0; }
        ul, ol { padding: 0; list-style: none; }
        button, input, select, textarea { font: inherit; border-radius: var(--radius-sm); }
        button { cursor: pointer; border: 1px solid transparent; }
        img { display: block; max-width: 100%; height: auto; }
        a { color: inherit; text-decoration: none; }

        body {
            min-width: 320px;
            background: var(--color-background);
            background-image: radial-gradient(circle at 10% 20%, #fffdfa 0%, #faf7f2 90%);
            color: var(--color-text);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
            font-size: 1rem;
            line-height: 1.6;
        }

        body.modal-open { overflow: hidden !important; }

        main > section, main > .page {
            max-width: var(--container-width);
            margin-inline: auto;
            padding: var(--space-8) var(--space-6);
        }

        .page { animation: fadeIn 220ms ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .page-header { margin-bottom: var(--space-8); }
        .page-header p { max-width: 720px; }
        strong { font-weight: 700; }

        h1, h2, h3, h4 { color: var(--color-text); font-weight: 800; line-height: 1.25; }
        h1 { font-size: clamp(2.2rem, 4vw, 3.4rem); letter-spacing: -0.03em; }
        h2 { font-size: clamp(1.4rem, 2vw, 1.9rem); margin-bottom: var(--space-4); }
        h3 { font-size: 1.15rem; }
        p { color: var(--color-text-secondary); }

        .platform-label {
            margin-bottom: var(--space-2);
            color: var(--color-primary);
            font-size: 0.85rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        /* HEADER & NAVIGATION */
        .brand a { display: inline-flex; align-items: center; gap: var(--space-3); font-size: 1.25rem; font-weight: 900; color: var(--color-primary); }
        .logo-placeholder {
            display: inline-grid; width: 2.5rem; height: 2.5rem; place-items: center;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--color-primary), var(--color-accent-teal)); 
            color: var(--color-white); font-size: 0.9rem; font-weight: 900;
            box-shadow: 0 4px 14px rgba(25, 62, 48, 0.25);
        }

        #site-header {
            position: sticky; top: 0; z-index: 100;
            display: flex; justify-content: space-between; align-items: center;
            min-height: 5rem; padding: 0 var(--space-6);
            border-bottom: 1px solid var(--color-border); 
            background: rgba(250, 247, 242, 0.88);
            backdrop-filter: blur(14px);
            box-shadow: var(--shadow-sm);
        }

        #site-header nav ul { display: flex; align-items: center; gap: var(--space-2); }
        #site-header nav a {
            display: inline-flex; align-items: center; min-height: 2.6rem; padding: 0 var(--space-4);
            border-radius: var(--radius-md); color: var(--color-text-secondary); font-size: 0.9rem; font-weight: 600;
            transition: all var(--transition-fast);
        }
        #site-header nav a:hover, #site-header nav a[aria-current="page"] {
            background: var(--color-primary-light); color: var(--color-primary-dark);
        }

        /* BUTTONS COLORFUL & ELEGAN */
        .btn-primary, .btn-secondary, .btn-danger, .btn-warning {
            display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
            min-height: 2.8rem; padding: 0.65rem 1.3rem;
            border-radius: var(--radius-md); font-weight: 700; font-size: 0.9rem;
            transition: all var(--transition-fast); cursor: pointer;
        }
        .btn-primary { 
            background: linear-gradient(135deg, var(--color-primary), #2d5a49); 
            color: var(--color-white); border: none; 
            box-shadow: 0 6px 18px rgba(25, 62, 48, 0.2);
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(25, 62, 48, 0.3); }
        .btn-secondary { background: var(--color-surface); color: var(--color-text); border: 1.5px solid var(--color-border-strong); }
        .btn-secondary:hover { background: var(--color-surface-soft); border-color: var(--color-primary); color: var(--color-primary); }
        .btn-danger { background: var(--color-danger); color: var(--color-white); border: none; }
        .btn-danger:hover { transform: translateY(-1px); background: #dc2626; }
        .btn-warning { background: var(--color-accent-amber); color: var(--color-white); border: none; }
        .btn-warning:hover { background: #b45309; }
        .btn-sm { min-height: 2.2rem; padding: 0.4rem 0.9rem; font-size: 0.825rem; }

        /* NOTIFICATION BELL BUTTON */
        .notif-bell-btn {
            position: relative; background: var(--color-surface); border: 1.5px solid var(--color-border);
            padding: 0.5rem 0.9rem; border-radius: var(--radius-md); font-weight: 700; font-size: 0.85rem;
            display: inline-flex; align-items: center; gap: 0.4rem; color: var(--color-text); transition: all var(--transition-fast);
        }
        .notif-bell-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
        .notif-badge {
            background: var(--color-accent-coral); color: white; border-radius: 999px;
            padding: 0.1rem 0.45rem; font-size: 0.75rem; font-weight: 900;
        }

        /* HERO & CARDS COLORFUL */
        #beranda > .page-header {
            padding: clamp(2.8rem, 5vw, 4.2rem) clamp(1.8rem, 4vw, 3.8rem);
            border-radius: var(--radius-xl);
            background: linear-gradient(135deg, #ffffff 0%, #f4efe6 100%);
            border: 1.5px solid var(--color-border);
            box-shadow: var(--shadow-md);
        }
        .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

        .report-category-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--space-5); }
        .report-category {
            display: flex; flex-direction: column; padding: var(--space-6);
            border-radius: var(--radius-lg);
            background: var(--color-surface); 
            border: 1px solid var(--color-border);
            box-shadow: var(--shadow-sm);
            transition: transform var(--transition-fast), box-shadow var(--transition-fast);
        }
        .report-category:hover { transform: translateY(-5px); box-shadow: var(--shadow-md); }
        
        .card-kecurangan { border-top: 6px solid var(--color-accent-coral); }
        .card-fasilitas { border-top: 6px solid var(--color-primary); }
        .card-pungli { border-top: 6px solid var(--color-warning); }
        .card-kebersihan { border-top: 6px solid var(--color-accent-teal); }
        .card-pelayanan { border-top: 6px solid #8b5cf6; }
        .card-kehilangan { border-top: 6px solid #d97706; background: linear-gradient(180deg, #fffdfa 0%, #ffffff 100%); }

        .report-category ul { display: grid; gap: var(--space-2); margin: var(--space-4) 0 var(--space-6); }
        .report-category li { position: relative; padding-left: 1rem; color: var(--color-text-secondary); font-size: 0.875rem; }
        .report-category li::before { content: "•"; position: absolute; left: 0; color: var(--color-primary); font-weight: bold; }

        /* STATS & PROGRESS BARS */
        .statistics-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-4); }
        .statistics-summary article { 
            padding: var(--space-5); border-radius: var(--radius-lg); 
            background: var(--color-surface); border: 1px solid var(--color-border);
            box-shadow: var(--shadow-sm); text-align: center;
        }
        .statistics-summary data { display: block; margin-top: var(--space-2); font-size: 2.2rem; font-weight: 900; color: var(--color-primary); }

        .stat-card-box { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); margin-bottom: 1.5rem; box-shadow: var(--shadow-sm); }
        .progress-bar-bg { width: 100%; height: 12px; background: var(--color-surface-soft); border-radius: 999px; overflow: hidden; margin: 0.5rem 0 1.2rem; }
        .progress-bar-fill { height: 100%; background: var(--color-primary); width: 0%; transition: width 0.4s ease; }

        /* FORMS & INPUTS */
        fieldset { margin-bottom: var(--space-6); padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-sm); }
        legend { padding-inline: var(--space-3); font-weight: 800; color: var(--color-primary); }
        
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); }
        .form-field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: var(--space-4); }
        label { font-weight: 600; font-size: 0.875rem; color: var(--color-text); }
        input, select, textarea {
            width: 100%; border: 1.5px solid var(--color-border-strong); background: var(--color-surface);
            color: var(--color-text); padding: 0.75rem 0.95rem; border-radius: var(--radius-md); outline: none;
            transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
        }
        textarea { min-height: 7rem; resize: vertical; }
        input:focus, select:focus, textarea:focus { border-color: var(--color-primary); box-shadow: 0 0 0 4px rgba(25, 62, 48, 0.12); }

        .radio-group, .checkbox-group { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 0.2rem; }
        .radio-label, .checkbox-label { 
            display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 600; 
            cursor: pointer; background: var(--color-surface-soft); padding: 0.5rem 0.9rem; 
            border-radius: var(--radius-md); border: 1px solid var(--color-border); 
        }
        .radio-label input, .checkbox-label input { width: auto; margin: 0; accent-color: var(--color-primary); }

        /* LIST & BADGES */
        .latest-report-list { display: grid; gap: var(--space-4); }
        .report-card { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-sm); transition: all var(--transition-fast); }
        .report-card:hover { border-color: var(--color-border-strong); }
        .status { display: inline-flex; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 800; }
        .status-reported { background: var(--color-warning-bg); color: #b45309; }
        .status-process { background: #e0f2fe; color: #0369a1; }
        .status-completed { background: var(--color-success-bg); color: var(--color-success); }
        
        .badge-urgency { padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.75rem; font-weight: 800; }
        .urgency-Biasa { background: #f1f5f9; color: #475569; }
        .urgency-Penting { background: var(--color-warning-bg); color: #b45309; }
        .urgency-Darurat { background: var(--color-danger-bg); color: var(--color-danger); }
        .preview-img { max-height: 200px; width: 100%; border-radius: var(--radius-md); margin-top: 0.8rem; display: none; border: 1px solid var(--color-border); object-fit: cover; }

        /* NOTIF & PETUNJUK BADGES */
        .badge-kehilangan { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-weight: 800; }
        .clues-box { margin-top: 1rem; padding: 1rem; background: #fffdfa; border: 1.5px dashed #f59e0b; border-radius: var(--radius-md); }
        .clue-item { padding: 0.6rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); margin-top: 0.5rem; }

        /* MODAL AUTH & GENERAL MODALS */
        .modal { 
            position: fixed; inset: 0; z-index: 1000; 
            display: none; align-items: center; justify-content: center; 
            background: rgba(15, 23, 19, 0.65); backdrop-filter: blur(6px); 
            padding: 1.5rem 1rem; 
            overflow-y: auto; 
        }

        .modal-content { 
            position: relative; background: var(--color-surface); 
            padding: var(--space-6); border-radius: var(--radius-xl); 
            max-width: 520px; width: 100%; box-shadow: var(--shadow-lg); 
            max-height: 90vh; 
            overflow-y: auto;
            margin: auto;
            border: 1px solid var(--color-border);
        }

        .auth-tabs { display: flex; border-bottom: 2px solid var(--color-border); margin-bottom: var(--space-5); gap: 0.2rem; }
        .auth-tab-btn { flex: 1; padding: var(--space-3); border: none; background: none; font-weight: 700; font-size: 0.85rem; color: var(--color-text-muted); cursor: pointer; }
        .auth-tab-btn.active { border-bottom: 3px solid var(--color-primary); color: var(--color-primary); }
        .auth-tab-btn.officer-tab.active { border-bottom: 3px solid var(--color-danger); color: var(--color-danger); }

        footer.site-footer { text-align: center; padding: var(--space-8) var(--space-6); border-top: 1px solid var(--color-border); margin-top: var(--space-12); background: var(--color-surface); color: var(--color-text-muted); font-size: 0.875rem; }
    </style>
</head>

<body>

    <!-- GLOBAL HEADER -->
    <header id="site-header">
        <div class="brand">
            <a href="#beranda" class="nav-link" data-target="beranda">
                <span class="logo-placeholder">LK</span>
                <span>LAPORKITA</span>
            </a>
        </div>

        <nav aria-label="Navigasi utama">
            <ul>
                <li><a href="#beranda" class="nav-link" data-target="beranda">Beranda</a></li>
                <li><a href="#halaman-statistik" class="nav-link" data-target="halaman-statistik">Statistik Analitis</a></li>
                <li><a href="#peta-laporan" class="nav-link" data-target="peta-laporan">Peta Wilayah</a></li>
                <li><a href="#laporan-terbaru" class="nav-link" data-target="laporan-terbaru">Laporan Warga</a></li>
                <li><a href="#formulir-laporan" class="nav-link" data-target="formulir-laporan">Buat Laporan</a></li>
                <li id="nav-item-citizen-dash" style="display: none;"><a href="#akun-masyarakat" class="nav-link" data-target="akun-masyarakat">Laporan Saya</a></li>
                <li id="nav-item-officer-dash" style="display: none;"><a href="#dasbor-petugas" class="nav-link" data-target="dasbor-petugas" style="color:var(--color-danger); border:1px solid var(--color-border);">🛡️ Panel Petugas</a></li>
            </ul>
        </nav>

        <div style="display: flex; align-items: center; gap: 0.6rem;">
            <!-- BELL NOTIFIKASI MASSAL KEHILANGAN -->
            <button type="button" id="btn-open-notifications" class="notif-bell-btn">
                🔔 <span class="notif-badge" id="notif-count">0</span> Notifikasi
            </button>

            <div id="auth-header-action">
                <button type="button" id="btn-open-auth" class="btn-secondary btn-sm">Masuk / Daftar Akun</button>
            </div>
        </div>
    </header>

    <!-- MAIN APPLICATION -->
    <main id="main-content">

        <!-- BANNER NOTIFIKASI POP-UP MASSAL KEHILANGAN -->
        <div id="missing-alert-banner" style="display:none; background: linear-gradient(135deg, #f59e0b, #d97706); color: white; padding: 1rem 1.5rem; border-radius: var(--radius-lg); margin-bottom: 1.5rem; box-shadow: var(--shadow-md);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.8rem;">
                <div>
                    <strong>🚨 BANTUAN DARURAT WARGA DIBUTUHKAN!</strong>
                    <p style="color: white; margin: 0; font-size: 0.9rem;" id="banner-text">Ada laporan kehilangan orang/benda baru! Klik untuk melihat & kirim petunjuk bantuan.</p>
                </div>
                <button type="button" id="btn-view-missing-alert" class="btn-secondary btn-sm" style="background: white; color: #b45309; border: none;">💡 Lihat & Kirim Petunjuk</button>
            </div>
        </div>

        <!-- 01. BERANDA -->
        <section id="beranda" class="page">
            <header class="page-header">
                <p class="platform-label">Platform Partisipasi Publik & Transparansi</p>
                <h1>Laporkan & Pantau Masalah Lingkunganmu</h1>
                <p>LAPORKITA mempermudah warga untuk melaporkan fasilitas publik yang rusak, kecurangan MBG/Bansos, kebersihan lingkungan, laporan kehilangan orang/benda, hingga dugaan pungli oknum pejabat secara transparan.</p>

                <div class="hero-actions">
                    <a href="#formulir-laporan" class="nav-link btn-primary" data-target="formulir-laporan">✍️ Buat Laporan Sekarang</a>
                    <a href="#halaman-statistik" class="nav-link btn-secondary" data-target="halaman-statistik">📊 Lihat Statistik Wilayah</a>
                </div>
            </header>

            <section id="kategori-laporan" style="margin-top: 2rem;">
                <h2>Pilih Kategori Masalah</h2>
                <div class="report-category-list">

                    <article class="report-category card-kehilangan">
                        <h3 style="color: #d97706;">🔍 Laporan Kehilangan</h3>
                        <ul>
                            <li><strong>Kehilangan Orang</strong> (Anggota Keluarga / Anak)</li>
                            <li><strong>Benda Hilang</strong> (Dokumen, Dompet, Kendaraan)</li>
                            <li>Notifikasi Massal Otomatis ke Semua Warga</li>
                            <li>Fitur Kirim Petunjuk Lokasi ke Petugas</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-warning btn-category-select" data-category="Laporan Kehilangan" data-target="formulir-laporan">Lapor Kehilangan</a>
                    </article>

                    <article class="report-category card-kecurangan">
                        <h3 style="color: var(--color-accent-coral);">⚠️ Kecurangan & Program Publik</h3>
                        <ul>
                            <li>Makanan Tidak Layak MBG Sekolah</li>
                            <li>Oknum Pejabat / Pungli</li>
                            <li>Penyaluran Bansos Tidak Tepat Target</li>
                            <li>Indikasi Korup / Pengadaan Fiktif</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-secondary btn-category-select" data-category="Kecurangan & Program Publik" data-target="formulir-laporan">Lapor Kecurangan</a>
                    </article>

                    <article class="report-category card-fasilitas">
                        <h3 style="color: var(--color-primary);">🏗️ Fasilitas Publik</h3>
                        <ul>
                            <li>Jalan / Trotoar Rusak</li>
                            <li>Lampu Jalan Mati</li>
                            <li>Drainase Tersumbat</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-secondary btn-category-select" data-category="Fasilitas Publik" data-target="formulir-laporan">Lapor Fasilitas</a>
                    </article>

                    <article class="report-category card-pungli">
                        <h3 style="color: #d97706;">👮 Ketertiban & Pungli</h3>
                        <ul>
                            <li>Pungutan Tanpa Izin</li>
                            <li>Biaya di Luar Ketentuan</li>
                            <li>Gangguan Ketertiban</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-secondary btn-category-select" data-category="Ketertiban & Pungli" data-target="formulir-laporan">Lapor Pungli / Ketertiban</a>
                    </article>

                    <article class="report-category card-kebersihan">
                        <h3 style="color: var(--color-accent-teal);">🌱 Kebersihan & Lingkungan</h3>
                        <ul>
                            <li>Penumpukan Sampah</li>
                            <li>Pencemaran Limbah</li>
                            <li>Potensi Banjir</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-secondary btn-category-select" data-category="Kebersihan & Lingkungan" data-target="formulir-laporan">Lapor Lingkungan</a>
                    </article>

                    <article class="report-category card-pelayanan">
                        <h3 style="color: #8b5cf6;">🏢 Pelayanan Publik</h3>
                        <ul>
                            <li>Layanan Desa / Kelurahan</li>
                            <li>Administrasi Lambat</li>
                            <li>Keluhan Pelayanan</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-secondary btn-category-select" data-category="Pelayanan Publik" data-target="formulir-laporan">Lapor Pelayanan</a>
                    </article>
                </div>
            </section>

            <section style="margin-top: 3rem;">
                <h2>Laporan Warga Terbaru</h2>
                <div class="latest-report-list" id="home-report-list">Loading...</div>
            </section>
        </section>

        <!-- 02. HALAMAN STATISTIK -->
        <section id="halaman-statistik" class="page" style="display: none;">
            <header class="page-header">
                <h1>Statistik & Transparansi Wilayah</h1>
                <p>Data real-time penanganan pengaduan masyarakat oleh instansi penegak dan pelayanan publik.</p>
            </header>

            <div class="statistics-summary" style="margin-bottom: 2rem;">
                <article><h3>Total Masuk</h3><data id="stat-total">0</data></article>
                <article><h3>Dalam Verifikasi</h3><data id="stat-reported" style="color: var(--color-warning);">0</data></article>
                <article><h3>Proses Tindak Lanjut</h3><data id="stat-process" style="color: #0284c7;">0</data></article>
                <article><h3>Laporan Selesai</h3><data id="stat-completed" style="color: var(--color-success);">0</data></article>
                <article><h3>Persentase Selesai</h3><data id="stat-rate" style="color: var(--color-primary);">0%</data></article>
            </div>

            <div class="form-grid">
                <div class="stat-card-box">
                    <h3>Sebaran Berdasarkan Kategori</h3>
                    <p><small>Persentase pengaduan warga per jenis masalah</small></p>
                    <div style="margin-top: 1rem;">
                        <div><strong style="color:#d97706;">Laporan Kehilangan</strong> (<span id="count-cat-kehilangan">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-kehilangan" class="progress-bar-fill" style="background: #d97706;"></div></div>

                        <div><strong style="color:var(--color-accent-coral);">Kecurangan & Program Publik</strong> (<span id="count-cat-kecurangan">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-kecurangan" class="progress-bar-fill" style="background: var(--color-accent-coral);"></div></div>

                        <div><strong style="color:var(--color-primary);">Fasilitas Publik</strong> (<span id="count-cat-fasilitas">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-fasilitas" class="progress-bar-fill" style="background: var(--color-primary);"></div></div>

                        <div><strong style="color:var(--color-warning);">Ketertiban & Pungli</strong> (<span id="count-cat-pungli">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-pungli" class="progress-bar-fill" style="background: var(--color-warning);"></div></div>

                        <div><strong style="color:var(--color-accent-teal);">Kebersihan & Lingkungan</strong> (<span id="count-cat-lingkungan">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-lingkungan" class="progress-bar-fill" style="background: var(--color-accent-teal);"></div></div>

                        <div><strong style="color:#8b5cf6;">Pelayanan Publik</strong> (<span id="count-cat-pelayanan">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-pelayanan" class="progress-bar-fill" style="background: #8b5cf6;"></div></div>
                    </div>
                </div>

                <div class="stat-card-box">
                    <h3>Tingkat Urgensi Masalah</h3>
                    <p><small>Klasifikasi kedaruratan laporan</small></p>
                    <div style="margin-top: 1rem;">
                        <div>🟢 <strong>Biasa</strong> (<span id="count-urg-biasa">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-urg-biasa" class="progress-bar-fill" style="background: #64748b;"></div></div>

                        <div>🟡 <strong>Penting</strong> (<span id="count-urg-penting">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-urg-penting" class="progress-bar-fill" style="background: var(--color-warning);"></div></div>

                        <div>🔴 <strong>Darurat (Bahaya)</strong> (<span id="count-urg-darurat">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-urg-darurat" class="progress-bar-fill" style="background: var(--color-danger);"></div></div>
                    </div>
                </div>
            </div>
        </section>

