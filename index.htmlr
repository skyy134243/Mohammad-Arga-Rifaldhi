                <p>Isi formulir berikut dengan lengkap untuk mempercepat verifikasi dan tindak lanjut petugas.</p>
            </header>

            <form id="main-report-form">
                <fieldset>
                    <legend>1. Klasifikasi Masalah & Urgensi</legend>
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="report-category">Kategori Utama *</label>
                            <select id="report-category" required>
                                <option value="">-- Pilih Kategori --</option>
                                <option value="Laporan Kehilangan">🔍 Laporan Kehilangan (Orang Hilang / Benda Hilang)</option>
                                <option value="Kecurangan & Program Publik">⚠️ Kecurangan & Program Publik (MBG, Pejabat, Bansos)</option>
                                <option value="Fasilitas Publik">Fasilitas Publik</option>
                                <option value="Ketertiban & Pungli">Ketertiban & Pungli</option>
                                <option value="Kebersihan & Lingkungan">Kebersihan & Lingkungan</option>
                                <option value="Pelayanan Publik">Pelayanan Publik</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="report-subcategory">Sub-Kategori Spesifik *</label>
                            <select id="report-subcategory" required>
                                <option value="">-- Pilih Sub-Kategori --</option>
                                <option value="Kehilangan Orang">🔍 Kehilangan Orang (Missing Person)</option>
                                <option value="Benda Hilang">📦 Benda Hilang (Barang / Dokumen / Kendaraan)</option>
                                <option value="Makanan MBG">Makanan Tidak Layak MBG</option>
                                <option value="Jalan Rusak">Jalan / Trotoar Rusak</option>
                                <option value="Pungli">Pungutan Liar</option>
                                <option value="Sampah Lingkungan">Penumpukan Sampah</option>
                                <option value="Lainnya">Lainnya</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-field">
                        <label>Tingkat Urgensi Masalah *</label>
                        <div class="radio-group">
                            <label class="radio-label"><input type="radio" name="urgency" value="Biasa" checked> 🟢 Biasa</label>
                            <label class="radio-label"><input type="radio" name="urgency" value="Penting"> 🟡 Penting</label>
                            <label class="radio-label"><input type="radio" name="urgency" value="Darurat"> 🔴 Darurat (Bahaya / Kehilangan)</label>
                        </div>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>2. Detail Masalah & Lokasi Kejadian</legend>
                    <div class="form-field">
                        <label for="report-title">Judul Laporan *</label>
                        <input type="text" id="report-title" required placeholder="Tuliskan judul singkat (cth: Kehilangan Anak di Alun-Alun / Makanan Basi MBG)">
                    </div>

                    <div class="form-field">
                        <label for="report-description">Deskripsi Kronologi Kejadian *</label>
                        <textarea id="report-description" required placeholder="Jelaskan detail waktu, ciri-ciri fisik (jika orang/benda hilang), kronologi, dan nomor kontak aktif pelapor..."></textarea>
                    </div>

                    <div class="form-grid">
                        <div class="form-field">
