<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LAPORKITA - Platform Pengaduan, Orang & Benda Hilang</title>
    
    <style>
        :root {
            --color-primary: #4f46e5;
            --color-primary-dark: #4338ca;
            --color-primary-light: #e0e7ff;
            --color-accent-teal: #0d9488;
            --color-accent-coral: #ff5722;
            --color-background: #f8fafc;
            --color-surface: #ffffff;
            --color-surface-soft: #f1f5f9;
            --color-text: #0f172a;
            --color-text-secondary: #334155;
            --color-text-muted: #64748b;
            --color-border: #e2e8f0;
            --color-border-strong: #cbd5e1;
            --color-success: #10b981;
            --color-success-bg: #d1fae5;
            --color-warning: #f59e0b;
            --color-warning-bg: #fef3c7;
            --color-danger: #ef4444;
            --color-danger-bg: #fee2e2;
            --color-white: #ffffff;

            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 10px 25px -5px rgba(79, 70, 229, 0.1);
            --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1);

            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 18px;
            --radius-xl: 24px;

            --container-width: 1240px;
            --space-2: 0.5rem;
            --space-3: 0.75rem;
            --space-4: 1rem;
            --space-5: 1.25rem;
            --space-6: 1.5rem;
            --space-8: 2rem;
            --space-12: 3rem;
            --transition-fast: 150ms ease;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; font-size: 16px; }
        body, h1, h2, h3, h4, h5, h6, p, ul, ol { margin: 0; }
        ul, ol { padding: 0; list-style: none; }
        button, input, select, textarea { font: inherit; border-radius: var(--radius-sm); }
        button { cursor: pointer; border: 1px solid transparent; }
        img { display: block; max-width: 100%; height: auto; }
        a { color: inherit; text-decoration: none; }

        body {
            min-width: 320px;
            background: var(--color-background);
            color: var(--color-text);
            font-family: Inter, ui-sans-serif, system-ui, sans-serif;
            font-size: 1rem;
            line-height: 1.6;
        }

        body.modal-open { overflow: hidden !important; }

        main > section, main > .page {
            max-width: var(--container-width);
            margin-inline: auto;
            padding: var(--space-8) var(--space-6);
        }

        .page { animation: fadeIn 200ms ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .page-header { margin-bottom: var(--space-8); }
        h1, h2, h3, h4 { color: var(--color-text); font-weight: 800; line-height: 1.2; }
        h1 { font-size: clamp(2.1rem, 4vw, 3.2rem); letter-spacing: -0.03em; }
        h2 { font-size: clamp(1.4rem, 2vw, 1.9rem); margin-bottom: var(--space-4); }
        h3 { font-size: 1.1rem; }
        p { color: var(--color-text-secondary); }

        .platform-label {
            margin-bottom: var(--space-2);
            color: var(--color-primary);
            font-size: 0.85rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* HEADER & NAVIGATION */
        .brand a { display: inline-flex; align-items: center; gap: var(--space-3); font-size: 1.2rem; font-weight: 900; color: var(--color-primary); }
        .logo-placeholder {
            display: inline-grid; width: 2.4rem; height: 2.4rem; place-items: center;
            border-radius: var(--radius-md);
            background: linear-gradient(135deg, var(--color-primary), var(--color-accent-teal)); 
            color: var(--color-white); font-size: 0.85rem; font-weight: 900;
        }

        #site-header {
            position: sticky; top: 0; z-index: 100;
            display: flex; justify-content: space-between; align-items: center;
            min-height: 4.8rem; padding: 0 var(--space-6);
            border-bottom: 1px solid var(--color-border); 
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            box-shadow: var(--shadow-sm);
        }

        #site-header nav ul { display: flex; align-items: center; gap: var(--space-2); }
        #site-header nav a {
            display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 var(--space-4);
            border-radius: var(--radius-md); color: var(--color-text-secondary); font-size: 0.9rem; font-weight: 600;
            transition: all var(--transition-fast);
        }
        #site-header nav a:hover, #site-header nav a[aria-current="page"] {
            background: var(--color-primary-light); color: var(--color-primary-dark);
        }

        /* BUTTONS */
        .btn-primary, .btn-secondary, .btn-danger, .btn-warning {
            display: inline-flex; align-items: center; justify-content: center;
            min-height: 2.7rem; padding: 0.6rem 1.2rem;
            border-radius: var(--radius-md); font-weight: 700; font-size: 0.9rem;
            transition: all var(--transition-fast); cursor: pointer;
        }
        .btn-primary { 
            background: linear-gradient(135deg, var(--color-primary), #6366f1); 
            color: var(--color-white); border: none; 
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
        }
        .btn-primary:hover { transform: translateY(-1px); }
        .btn-secondary { background: var(--color-surface); color: var(--color-text); border: 1.5px solid var(--color-border-strong); }
        .btn-secondary:hover { background: var(--color-surface-soft); border-color: var(--color-primary); color: var(--color-primary); }
        .btn-danger { background: var(--color-danger); color: var(--color-white); border: none; }
        .btn-warning { background: var(--color-warning); color: var(--color-text); border: none; }
        .btn-sm { min-height: 2.1rem; padding: 0.35rem 0.85rem; font-size: 0.825rem; }

        /* FORMS & INPUTS */
        fieldset { margin-bottom: var(--space-6); padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-sm); }
        legend { padding-inline: var(--space-3); font-weight: 800; color: var(--color-primary); }
        
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); }
        .form-field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: var(--space-4); }
        label { font-weight: 600; font-size: 0.875rem; color: var(--color-text); }
        input, select, textarea {
            width: 100%; border: 1.5px solid var(--color-border-strong); background: var(--color-surface);
            color: var(--color-text); padding: 0.7rem 0.9rem; border-radius: var(--radius-md); outline: none;
            transition: border-color var(--transition-fast);
        }
        textarea { min-height: 6rem; resize: vertical; }
        input:focus, select:focus, textarea:focus { border-color: var(--color-primary); box-shadow: 0 0 0 4px var(--color-primary-light); }

        /* CARDS & BADGES */
        .latest-report-list { display: grid; gap: var(--space-4); }
        .report-card { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-sm); }
        .status { display: inline-flex; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 800; }
        .status-reported { background: var(--color-warning-bg); color: #b45309; }
        .status-process { background: #e0f2fe; color: #0369a1; }
        .status-completed { background: var(--color-success-bg); color: var(--color-success); }
        
        .badge-urgency { padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.75rem; font-weight: 800; }
        .urgency-Biasa { background: #f1f5f9; color: #475569; }
        .urgency-Penting { background: var(--color-warning-bg); color: #b45309; }
        .urgency-Darurat { background: var(--color-danger-bg); color: var(--color-danger); }
        .preview-img { max-height: 180px; border-radius: var(--radius-md); margin-top: 0.6rem; display: block; border: 1px solid var(--color-border); object-fit: cover; }

        /* MODAL */
        .modal { 
            position: fixed; inset: 0; z-index: 1000; 
            display: none; align-items: center; justify-content: center; 
            background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(6px); 
            padding: 1.5rem 1rem; overflow-y: auto; 
        }

        .modal-content { 
            position: relative; background: var(--color-surface); 
            padding: var(--space-6); border-radius: var(--radius-xl); 
            max-width: 500px; width: 100%; box-shadow: var(--shadow-lg); 
            max-height: 90vh; overflow-y: auto; margin: auto;
            border: 1px solid var(--color-border);
        }

        .auth-tabs { display: flex; border-bottom: 2px solid var(--color-border); margin-bottom: var(--space-5); gap: 0.2rem; }
        .auth-tab-btn { flex: 1; padding: var(--space-3); border: none; background: none; font-weight: 700; font-size: 0.85rem; color: var(--color-text-muted); cursor: pointer; }
        .auth-tab-btn.active { border-bottom: 3px solid var(--color-primary); color: var(--color-primary); }
        .auth-tab-btn.officer-tab.active { border-bottom: 3px solid var(--color-danger); color: var(--color-danger); }

        /* BANNER BROADCAST NOTIFIKASI DARURAT HILANG */
        #broadcast-alert-container {
            position: fixed; bottom: 20px; right: 20px; z-index: 999;
            max-width: 380px; display: flex; flex-direction: column; gap: 10px;
        }
        .broadcast-card {
            background: #fff; border-left: 6px solid var(--color-danger);
            padding: 1rem; border-radius: var(--radius-md);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            animation: slideIn 0.3s ease-out;
        }
        @keyframes slideIn { from { transform: translateX(100%); } to { transform: translateX(0); } }

        footer.site-footer { text-align: center; padding: var(--space-8) var(--space-6); border-top: 1px solid var(--color-border); margin-top: var(--space-12); background: var(--color-surface); color: var(--color-text-muted); font-size: 0.875rem; }
    </style>
</head>

<body>

    <!-- CONTAINER NOTIFIKASI SIARAN LOKAL (BROADCAST) -->
    <div id="broadcast-alert-container"></div>

    <!-- GLOBAL HEADER -->
    <header id="site-header">
        <div class="brand">
            <a href="#beranda" class="nav-link" data-target="beranda">
                <span class="logo-placeholder">LK</span>
                <span>LAPORKITA</span>
            </a>
        </div>

        <nav aria-label="Navigasi utama">
            <ul>
                <li><a href="#beranda" class="nav-link" data-target="beranda">Beranda</a></li>
                <li><a href="#orang-benda-hilang" class="nav-link" data-target="orang-benda-hilang" style="color:var(--color-accent-coral);">🚨 Orang & Benda Hilang</a></li>
                <li><a href="#laporan-terbaru" class="nav-link" data-target="laporan-terbaru">Laporan Warga</a></li>
                <li><a href="#formulir-laporan" class="nav-link" data-target="formulir-laporan">Buat Pengaduan</a></li>
                <li id="nav-item-citizen-dash" style="display: none;"><a href="#akun-masyarakat" class="nav-link" data-target="akun-masyarakat">Laporan Saya</a></li>
                <li id="nav-item-officer-dash" style="display: none;"><a href="#dasbor-petugas" class="nav-link" data-target="dasbor-petugas" style="color:var(--color-danger); border:1px solid var(--color-border);">🛡️ Panel Petugas</a></li>
            </ul>
        </nav>

        <div id="auth-header-action">
            <button type="button" id="btn-open-auth" class="btn-secondary btn-sm">Masuk / Daftar Akun</button>
        </div>
    </header>

    <!-- MAIN APPLICATION -->
    <main id="main-content">

        <!-- 01. BERANDA -->
        <section id="beranda" class="page">
            <header class="page-header">
                <p class="platform-label">Platform Partisipasi Publik & Transparansi</p>
                <h1>Laporkan Masalah Lingkungan, Orang & Benda Hilang</h1>
                <p>Platform terintegrasi warga dan petugas untuk penanganan pengaduan publik, serta tanggap darurat pencarian orang/benda hilang secara real-time.</p>

                <div style="display:flex; gap:1rem; margin-top:1.5rem; flex-wrap:wrap;">
                    <a href="#formulir-laporan" class="nav-link btn-primary" data-target="formulir-laporan">✍️ Buat Laporan Pengaduan</a>
                    <a href="#orang-benda-hilang" class="nav-link btn-danger" data-target="orang-benda-hilang">🚨 Lapor / Cari Orang & Benda Hilang</a>
                </div>
            </header>
        </section>

        <!-- 02. MODUL BARU: ORANG & BENDA HILANG -->
        <section id="orang-benda-hilang" class="page" style="display: none;">
            <header class="page-header">
                <p class="platform-label" style="color:var(--color-danger);">Sistem Tanggap Darurat Komunitas</p>
                <h1>Pusat Informasi Orang & Benda Hilang</h1>
                <p>Informasi yang dipublikasikan di sini akan dikirimkan sebagai <strong>Notifikasi Broadcast Real-Time</strong> ke seluruh pengguna. Berikan petunjuk jika Anda melihatnya untuk ditindaklanjuti petugas.</p>
            </header>

            <div style="margin-bottom: 2rem;">
                <button type="button" class="btn-danger" id="btn-show-lost-form">📢 Buat Laporan Orang / Benda Hilang</button>
            </div>

            <!-- FORMULIR PELAPORAN HILANG -->
            <div id="form-lost-container" style="display: none; margin-bottom: 2rem;">
                <form id="lost-report-form">
                    <fieldset style="border-color: var(--color-danger);">
                        <legend style="color: var(--color-danger);">Formulir Darurat Orang / Benda Hilang</legend>
                        <div class="form-grid">
                            <div class="form-field">
                                <label for="lost-type">Tipe Laporan *</label>
                                <select id="lost-type" required>
                                    <option value="Orang Hilang">🧍 Orang Hilang</option>
                                    <option value="Benda Hilang">🎒 Benda / Barang Hilang</option>
                                </select>
                            </div>
                            <div class="form-field">
                                <label for="lost-title">Nama Subjek / Nama Benda Hilang *</label>
                                <input type="text" id="lost-title" required placeholder="Contoh: Anak Hilang (Budi, 8 Thn) / Dompet Hitam">
                            </div>
                        </div>

                        <div class="form-grid">
                            <div class="form-field">
                                <label for="lost-last-seen">Lokasi Terakhir Dilihat *</label>
                                <input type="text" id="lost-last-seen" required placeholder="Contoh: Alun-Alun Kota / Stasiun KA">
                            </div>
                            <div class="form-field">
                                <label for="lost-contact">Nomor Kontak Darurat (Keluarga/Pemilik) *</label>
                                <input type="text" id="lost-contact" required placeholder="0812345678xx">
                            </div>
                        </div>

                        <div class="form-field">
                            <label for="lost-description">Ciri-ciri Khusus & Kronologi Kejadian *</label>
                            <textarea id="lost-description" required placeholder="Jelaskan pakaian terakhir, warna benda, nomor plat, atau tanda khusus lainnya..."></textarea>
                        </div>

                        <div class="form-field">
                            <label for="lost-photo">Foto Subjek / Benda *</label>
                            <input type="file" id="lost-photo" accept="image/*" required>
                            <img id="lost-photo-preview" class="preview-img" style="display:none;" alt="Preview Foto">
                        </div>

                        <div style="display:flex; gap:1rem; margin-top:1rem;">
                            <button type="submit" class="btn-danger">🚀 Siarkan Notifikasi Darurat</button>
                            <button type="button" class="btn-secondary" id="btn-cancel-lost-form">Batal</button>
                        </div>
                    </fieldset>
                </form>
            </div>

            <!-- DAFTAR PENCARIAN AKTIF -->
            <h2>Daftar Pencarian Aktif Warga</h2>
            <div id="lost-items-list" class="latest-report-list" style="margin-top: 1rem;">Memuat data...</div>
        </section>

        <!-- 03. LAPORAN TERBARU WARGA -->
        <section id="laporan-terbaru" class="page" style="display: none;">
            <header class="page-header">
                <h1>Kumpulan Laporan Pengaduan Warga</h1>
                <p>Daftar pengaduan fasilitas, kebersihan, dan pelayanan publik yang dikirimkan warga.</p>
            </header>
            <div class="latest-report-list" id="all-reports-list">Memuat laporan...</div>
        </section>

        <!-- 04. FORMULIR LAPORAN PENGADUAN -->
        <section id="formulir-laporan" class="page" style="display: none;">
            <header class="page-header">
                <h1>Buat Laporan Pengaduan Publik</h1>
                <p>Isi formulir pengaduan fasilitas atau masalah publik berikut.</p>
            </header>

            <form id="main-report-form">
                <fieldset>
                    <legend>1. Detail Pengaduan</legend>
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="report-category">Kategori Utama *</label>
                            <select id="report-category" required>
                                <option value="">-- Pilih Kategori --</option>
                                <option value="Fasilitas Publik">Fasilitas Publik</option>
                                <option value="Ketertiban & Pungli">Ketertiban & Pungli</option>
                                <option value="Kebersihan & Lingkungan">Kebersihan & Lingkungan</option>
                                <option value="Pelayanan Publik">Pelayanan Publik</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="report-title">Judul Laporan *</label>
                            <input type="text" id="report-title" required placeholder="Ringkasan masalah">
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="report-description">Deskripsi Kronologi Kejadian *</label>
                        <textarea id="report-description" required placeholder="Jelaskan detail masalah..."></textarea>
                    </div>

                    <div class="form-field">
                        <label for="location-name">Lokasi Kejadian *</label>
                        <input type="text" id="location-name" required placeholder="Alamat atau patokan lokasi">
                    </div>

                    <button type="submit" id="btn-submit-report" class="btn-primary" style="margin-top:1rem;">🚀 Kirim Laporan Pengaduan</button>
                </fieldset>
            </form>
        </section>

        <!-- 05. DASBOR WARGA -->
        <section id="akun-masyarakat" class="page" style="display: none;">
            <header class="page-header">
                <h1>Dashboard Pengaduan Saya</h1>
                <p>Riwayat laporan pengaduan yang pernah kamu buat.</p>
            </header>
            <div id="my-reports-list" class="latest-report-list">Memuat data...</div>
        </section>

        <!-- 06. DASBOR PETUGAS -->
        <section id="dasbor-petugas" class="page" style="display: none;">
            <header class="page-header">
                <p class="platform-label" style="color:var(--color-danger);">Akses Terverifikasi Petugas</p>
                <h1>Panel Kontrol Penegak & Petugas Wilayah</h1>
                <p>Kelola laporan masuk serta pantau <strong>petunjuk lokasi dari warga</strong> untuk penanganan darurat.</p>
            </header>

            <h2>📍 Petunjuk Lokasi Orang/Benda Hilang dari Warga</h2>
            <div id="officer-clues-list" class="latest-report-list" style="margin-bottom: 2.5rem; margin-top: 1rem;">Memuat petunjuk...</div>

            <h2>📋 Daftar Pengaduan Masuk</h2>
            <div id="officer-reports-list" class="latest-report-list" style="margin-top: 1rem;">Memuat data...</div>
        </section>

    </main>

    <!-- MODAL AUTHENTICATION -->
    <div id="auth-modal" class="modal">
        <div class="modal-content">
            <div class="auth-tabs">
                <button type="button" class="auth-tab-btn active" id="tab-btn-login">Login Warga</button>
                <button type="button" class="auth-tab-btn officer-tab" id="tab-btn-officer">🛡️ Login Petugas</button>
                <button type="button" class="auth-tab-btn" id="tab-btn-register">Daftar Akun</button>
            </div>

            <!-- FORM LOGIN WARGA -->
            <form id="form-login">
                <h2>Masuk Warga LAPORKITA</h2>
                <div style="background:var(--color-primary-light); padding:0.6rem; border-radius:6px; margin:0.8rem 0; font-size:0.8rem; color:var(--color-primary-dark);">
                    💡 <strong>Akun Demo:</strong> Username/Email: <code>arga</code> | Pass: <code>password123</code>
                </div>
                <div class="form-field">
                    <label for="login-email">Email / Username</label>
                    <input type="text" id="login-email" required placeholder="email@domain.com atau username">
                </div>
                <div class="form-field">
                    <label for="login-password">Kata Sandi</label>
                    <input type="password" id="login-password" required placeholder="Password">
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem;">Masuk Akun Warga</button>
            </form>

            <!-- FORM LOGIN PETUGAS -->
            <form id="form-login-officer" style="display: none;">
                <h2 style="color:var(--color-danger);">Akses Penegak / Petugas</h2>
                <div style="background:var(--color-danger-bg); padding:0.6rem; border-radius:6px; margin:0.8rem 0; font-size:0.8rem; color:var(--color-danger);">
                    🛡️ <strong>Demo Petugas:</strong> Username: <code>petugas</code> | Pass: <code>password123</code> | Kode: <code>3826252718</code>
                </div>
                <div class="form-field">
                    <label for="officer-email">Email / Username Petugas</label>
                    <input type="text" id="officer-email" required placeholder="petugas / email@instansi.go.id">
                </div>
                <div class="form-field">
                    <label for="officer-password">Kata Sandi</label>
                    <input type="password" id="officer-password" required placeholder="Password">
                </div>
                <div class="form-field">
                    <label for="officer-code" style="color:var(--color-danger);">Kode Verifikasi Petugas *</label>
                    <input type="text" id="officer-code" required placeholder="Kode: 3826252718">
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem; background: var(--color-danger); border-color: var(--color-danger);">Masuk Panel Petugas</button>
            </form>

            <!-- FORM REGISTER -->
            <form id="form-register" style="display: none;">
                <h2>Buat Akun Baru</h2>
                <div class="form-field" style="margin-top:1rem;">
                    <label for="reg-role">Daftar Sebagai *</label>
                    <select id="reg-role" required>
                        <option value="warga">Masyarakat / Warga</option>
                        <option value="officer">Penegak / Petugas Wilayah</option>
                    </select>
                </div>
                <div class="form-field">
                    <label for="reg-fullname">Nama Lengkap *</label>
                    <input type="text" id="reg-fullname" required placeholder="Sesuai KTP">
                </div>
                <div class="form-field">
                    <label for="reg-username">Username *</label>
                    <input type="text" id="reg-username" required placeholder="username">
                </div>
                <div class="form-field">
                    <label for="reg-email">Alamat Email *</label>
                    <input type="email" id="reg-email" required placeholder="nama@email.com">
                </div>
                <div class="form-field">
                    <label for="reg-password">Password *</label>
                    <input type="password" id="reg-password" minlength="6" required placeholder="Min 6 Karakter">
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem;">Daftar Akun LAPORKITA</button>
            </form>

            <button type="button" id="btn-close-modal" class="btn-secondary btn-sm" style="width: 100%; margin-top: 1rem;">Batal</button>
        </div>
    </div>

    <!-- MODAL PETUNJUK LOKASI (WARGA TO PETUGAS) -->
    <div id="clue-modal" class="modal">
        <div class="modal-content">
            <h2 style="color: var(--color-primary);">💡 Beri Petunjuk / Petunjuk Lokasi</h2>
            <p style="font-size:0.85rem; color:var(--color-text-muted); margin-bottom:1rem;">Informasi yang Anda berikan akan dikirim langsung ke <strong>Panel Petugas Penegak</strong> untuk menuju lokasi.</p>
            
            <form id="form-send-clue">
                <input type="hidden" id="clue-target-id">
                <div class="form-field">
                    <label for="clue-location">Lokasi Terakhir Anda Melihatnya *</label>
                    <input type="text" id="clue-location" required placeholder="Contoh: Terlihat di dekat Halte Bus Depan Pasar">
                </div>
                <div class="form-field">
                    <label for="clue-note">Catatan Tambahan / Detail Keterangan *</label>
                    <textarea id="clue-note" required placeholder="Contoh: Menggunakan baju merah, berjalan ke arah utara pukul 14.30"></textarea>
                </div>
                <button type="submit" class="btn-primary" style="width:100%;">🚀 Kirimkan ke Petugas Wilayah</button>
                <button type="button" id="btn-close-clue-modal" class="btn-secondary btn-sm" style="width:100%; margin-top:0.5rem;">Batal</button>
            </form>
        </div>
    </div>

    <footer class="site-footer">
        <p>&copy; 2026 LAPORKITA - Platform Civic-Tech Terpadu & Tanggap Darurat Komunitas.</p>
    </footer>

    <!-- SCRIPT UTAMA PLATFORM -->
    <script>
        (() => {
            'use strict';
            
            const SESSION_KEY = 'laporkita_session';
            const LOCAL_USERS_KEY = 'laporkita_local_users';
            const LOCAL_REPORTS_KEY = 'laporkita_local_reports';
            const LOCAL_LOST_KEY = 'laporkita_local_lost';
            const LOCAL_CLUES_KEY = 'laporkita_local_clues';
            const FIXED_OFFICER_CODE = '3826252718';

            // DUMMY INITIAL SEED DATA KONSISTEN
            const DEFAULT_USERS = [
                { id: '1', fullname: 'Mohammad Arga', username: 'arga', email: 'arga@test.com', password: 'password123', role: 'warga' },
                { id: '2', fullname: 'Bripka Susanto (Satgas)', username: 'petugas', email: 'petugas@polri.go.id', password: 'password123', role: 'officer' }
            ];

            if (!localStorage.getItem(LOCAL_USERS_KEY)) {
                localStorage.setItem(LOCAL_USERS_KEY, JSON.stringify(DEFAULT_USERS));
            }

            if (!localStorage.getItem(LOCAL_REPORTS_KEY)) {
                localStorage.setItem(LOCAL_REPORTS_KEY, JSON.stringify([
                    { id: '1', code: 'LK-889123', category: 'Fasilitas Publik', title: 'Jalan Berlubang', description: 'Lubang jalan cukup besar di persimpangan.', location: 'Jl. Merdeka No 45', reporterName: 'Mohammad Arga', reporterEmail: 'arga@test.com', status: 'reported' }
                ]));
            }

            if (!localStorage.getItem(LOCAL_LOST_KEY)) {
                localStorage.setItem(LOCAL_LOST_KEY, JSON.stringify([
                    { id: '1', code: 'HST-001', type: 'Orang Hilang', title: 'Anak Hilang (Budi - 8 Tahun)', lastSeen: 'Taman Kota Merdeka', contact: '081299887766', description: 'Menggunakan kaos biru, celana pendek hitam. Terakhir terlihat jam 10 pagi.', photo: '', status: 'active', createdAt: new Date().toISOString() }
                ]));
            }

            if (!localStorage.getItem(LOCAL_CLUES_KEY)) {
                localStorage.setItem(LOCAL_CLUES_KEY, JSON.stringify([]));
            }

            // AMBIL USER DARI LOCALSTORAGE SECARA REAKSIF DAN INSTAN
            function getUsersSync() {
                try {
                    const data = JSON.parse(localStorage.getItem(LOCAL_USERS_KEY));
                    if (Array.isArray(data) && data.length > 0) return data;
                } catch(e) {}
                localStorage.setItem(LOCAL_USERS_KEY, JSON.stringify(DEFAULT_USERS));
                return DEFAULT_USERS;
            }

            function saveUserSync(newUser) {
                const users = getUsersSync();
                newUser.id = Date.now().toString();
                users.push(newUser);
                localStorage.setItem(LOCAL_USERS_KEY, JSON.stringify(users));
                return newUser;
            }

            function getReportsSync() {
                return JSON.parse(localStorage.getItem(LOCAL_REPORTS_KEY) || '[]').reverse();
            }

            function saveReportSync(newReport) {
                const reports = JSON.parse(localStorage.getItem(LOCAL_REPORTS_KEY) || '[]');
                newReport.id = Date.now().toString();
                reports.push(newReport);
                localStorage.setItem(LOCAL_REPORTS_KEY, JSON.stringify(reports));
                return newReport;
            }

            function getLostItems() { return JSON.parse(localStorage.getItem(LOCAL_LOST_KEY) || '[]'); }
            function saveLostItem(item) {
                const lost = getLostItems();
                lost.unshift(item);
                localStorage.setItem(LOCAL_LOST_KEY, JSON.stringify(lost));
            }

            function getClues() { return JSON.parse(localStorage.getItem(LOCAL_CLUES_KEY) || '[]'); }
            function saveClue(clue) {
                const clues = getClues();
                clues.unshift(clue);
                localStorage.setItem(LOCAL_CLUES_KEY, JSON.stringify(clues));
            }

            function getSession() {
                try { return JSON.parse(localStorage.getItem(SESSION_KEY)); } catch(e) { return null; }
            }
            function setSession(val) {
                try { localStorage.setItem(SESSION_KEY, JSON.stringify(val)); } catch(e) {}
            }

            function navigateTo(targetId) {
                document.querySelectorAll('.page').forEach(p => p.style.display = 'none');
                const targetPage = document.getElementById(targetId) || document.getElementById('beranda');
                targetPage.style.display = 'block';

                document.querySelectorAll('#site-header nav a').forEach(a => {
                    if (a.getAttribute('data-target') === targetId) a.setAttribute('aria-current', 'page');
                    else a.removeAttribute('aria-current');
                });

                window.scrollTo(0, 0);
                renderAllData();
            }

            // MODAL & AUTHENTICATION
            const authModal = document.getElementById('auth-modal');
            const tabLoginBtn = document.getElementById('tab-btn-login');
            const tabOfficerBtn = document.getElementById('tab-btn-officer');
            const tabRegBtn = document.getElementById('tab-btn-register');
            
            const formLogin = document.getElementById('form-login');
            const formLoginOfficer = document.getElementById('form-login-officer');
            const formRegister = document.getElementById('form-register');

            function openModal() { authModal.style.display = 'flex'; document.body.classList.add('modal-open'); }
            function closeModal() { authModal.style.display = 'none'; document.body.classList.remove('modal-open'); }

            document.getElementById('btn-open-auth').addEventListener('click', openModal);

            tabLoginBtn.addEventListener('click', () => {
                tabLoginBtn.classList.add('active'); tabOfficerBtn.classList.remove('active'); tabRegBtn.classList.remove('active');
                formLogin.style.display = 'block'; formLoginOfficer.style.display = 'none'; formRegister.style.display = 'none';
            });

            tabOfficerBtn.addEventListener('click', () => {
                tabOfficerBtn.classList.add('active'); tabLoginBtn.classList.remove('active'); tabRegBtn.classList.remove('active');
                formLoginOfficer.style.display = 'block'; formLogin.style.display = 'none'; formRegister.style.display = 'none';
            });

            tabRegBtn.addEventListener('click', () => {
                tabRegBtn.classList.add('active'); tabLoginBtn.classList.remove('active'); tabOfficerBtn.classList.remove('active');
                formRegister.style.display = 'block'; formLogin.style.display = 'none'; formLoginOfficer.style.display = 'none';
            });

            document.getElementById('btn-close-modal').addEventListener('click', closeModal);

            // REGISTER AKUN
            formRegister.addEventListener('submit', (e) => {
                e.preventDefault();
                const users = getUsersSync();
                const email = document.getElementById('reg-email').value.trim().toLowerCase();
                const username = document.getElementById('reg-username').value.trim().toLowerCase();

                if (users.find(u => u.email.toLowerCase() === email || u.username.toLowerCase() === username)) {
                    alert('Email atau Username ini sudah terdaftar!');
                    return;
                }

                const newUser = {
                    fullname: document.getElementById('reg-fullname').value,
                    username: username,
                    email: email,
                    password: document.getElementById('reg-password').value,
                    role: document.getElementById('reg-role').value
                };

                const saved = saveUserSync(newUser);
                if (saved) {
                    if (newUser.role === 'officer') {
                        alert('Pendaftaran Petugas Berhasil! Silakan login di tab Login Petugas.');
                        tabOfficerBtn.click();
                    } else {
                        setSession(saved);
                        alert('Pendaftaran akun berhasil!');
                        closeModal();
                        updateAuthUI();
                        navigateTo('akun-masyarakat');
                    }
                }
            });

            // LOGIN WARGA - FIXED & INSTANT
            formLogin.addEventListener('submit', (e) => {
                e.preventDefault();
                const inputId = document.getElementById('login-email').value.trim().toLowerCase();
                const pass = document.getElementById('login-password').value;
                const users = getUsersSync();

                const user = users.find(u => 
                    (u.email.toLowerCase() === inputId || u.username.toLowerCase() === inputId) && 
                    u.password === pass
                );

                if (user) {
                    if (user.role === 'officer') {
                        alert('Akun ini terdaftar sebagai Petugas. Silakan masuk melalui tab "Login Petugas"!');
                        tabOfficerBtn.click();
                        return;
                    }
                    setSession(user);
                    alert(`Selamat datang kembali, ${user.fullname}!`);
                    closeModal();
                    updateAuthUI();
                    navigateTo('akun-masyarakat');
                } else {
                    alert('Email/Username atau Password salah! Periksa kembali data login Anda.');
                }
            });

            // LOGIN PETUGAS - FIXED & INSTANT
            formLoginOfficer.addEventListener('submit', (e) => {
                e.preventDefault();
                const inputId = document.getElementById('officer-email').value.trim().toLowerCase();
                const pass = document.getElementById('officer-password').value;
                const code = document.getElementById('officer-code').value.trim();

                if (code !== FIXED_OFFICER_CODE) {
                    alert('Kode Verifikasi Petugas salah! Silakan gunakan kode: 3826252718');
                    return;
                }

                const users = getUsersSync();
                const user = users.find(u => 
                    (u.email.toLowerCase() === inputId || u.username.toLowerCase() === inputId) && 
                    u.password === pass
                );

                if (user) {
                    if (user.role !== 'officer') {
                        alert('Akun ini terdaftar sebagai Warga, bukan Akun Petugas!');
                        return;
                    }
                    setSession(user);
                    alert(`Verifikasi Petugas Berhasil. Selamat bertugas, ${user.fullname}!`);
                    closeModal();
                    updateAuthUI();
                    navigateTo('dasbor-petugas');
                } else {
                    alert('Identitas Petugas atau Kata Sandi salah!');
                }
            });

            function updateAuthUI() {
                const session = getSession();
                const authHeaderAction = document.getElementById('auth-header-action');
                const citizenNav = document.getElementById('nav-item-citizen-dash');
                const officerNav = document.getElementById('nav-item-officer-dash');

                if (session) {
                    authHeaderAction.innerHTML = `
                        <span style="font-weight:700; font-size:0.85rem; color:var(--color-primary); margin-right:0.4rem;">👤 ${session.fullname} (${session.role === 'officer' ? 'Petugas' : 'Warga'})</span>
                        <button type="button" id="btn-logout" class="btn-secondary btn-sm">Keluar</button>
                    `;
                    citizenNav.style.display = session.role === 'warga' ? 'inline-block' : 'none';
                    officerNav.style.display = session.role === 'officer' ? 'inline-block' : 'none';

                    document.getElementById('btn-logout').addEventListener('click', () => {
                        localStorage.removeItem(SESSION_KEY);
                        alert('Anda telah keluar.');
                        updateAuthUI();
                        navigateTo('beranda');
                    });
                } else {
                    authHeaderAction.innerHTML = `<button type="button" id="btn-open-auth-nav" class="btn-secondary btn-sm">Masuk / Daftar Akun</button>`;
                    citizenNav.style.display = 'none';
                    officerNav.style.display = 'none';
                    document.getElementById('btn-open-auth-nav').addEventListener('click', openModal);
                }
            }

            // MODUL ORANG & BENDA HILANG
            const btnShowLostForm = document.getElementById('btn-show-lost-form');
            const formLostContainer = document.getElementById('form-lost-container');
            const btnCancelLostForm = document.getElementById('btn-cancel-lost-form');
            const lostPhotoInput = document.getElementById('lost-photo');
            const lostPhotoPreview = document.getElementById('lost-photo-preview');

            btnShowLostForm.addEventListener('click', () => {
                if (!getSession()) { alert('Silakan login terlebih dahulu untuk membuat laporan.'); openModal(); return; }
                formLostContainer.style.display = 'block';
            });
            btnCancelLostForm.addEventListener('click', () => formLostContainer.style.display = 'none');

            lostPhotoInput.addEventListener('change', () => {
                const file = lostPhotoInput.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (e) => { lostPhotoPreview.src = e.target.result; lostPhotoPreview.style.display = 'block'; };
                    reader.readAsDataURL(file);
                }
            });

            document.getElementById('lost-report-form').addEventListener('submit', function(e) {
                e.preventDefault();
                const session = getSession();

                const newItem = {
                    id: Date.now().toString(),
                    code: `HST-${Date.now().toString().slice(-4)}`,
                    type: document.getElementById('lost-type').value,
                    title: document.getElementById('lost-title').value,
                    lastSeen: document.getElementById('lost-last-seen').value,
                    contact: document.getElementById('lost-contact').value,
                    description: document.getElementById('lost-description').value,
                    photo: lostPhotoPreview.src || '',
                    reporterName: session ? session.fullname : 'Warga',
                    reporterEmail: session ? session.email : '-',
                    status: 'active',
                    createdAt: new Date().toISOString()
                };

                saveLostItem(newItem);
                triggerBroadcastAlert(newItem);
                this.reset();
                lostPhotoPreview.style.display = 'none';
                formLostContainer.style.display = 'none';
                alert('Laporan Darurat Hilang Berhasil Disiarkan ke seluruh Pengguna!');
                renderAllData();
            });

            // BROADCAST ALERT POPUP SIMULATION
            function triggerBroadcastAlert(item) {
                const container = document.getElementById('broadcast-alert-container');
                const card = document.createElement('div');
                card.className = 'broadcast-card';
                card.innerHTML = `
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <strong style="color:var(--color-danger); font-size:0.85rem;">🚨 SIARAN DARURAT: ${item.type.toUpperCase()}</strong>
                        <button onclick="this.parentElement.parentElement.remove()" style="background:none; border:none; cursor:pointer;">✖</button>
                    </div>
                    <h4 style="margin-top:0.3rem;">${item.title}</h4>
                    <p style="font-size:0.8rem; margin:0.3rem 0;">📍 Terakhir Terlihat: <strong>${item.lastSeen}</strong></p>
                    <button class="btn-warning btn-sm" style="width:100%; margin-top:0.4rem;" onclick="openClueModal('${item.id}', '${item.title}')">💡 Saya Ada Petunjuk / Melihatnya</button>
                `;
                container.appendChild(card);
                setTimeout(() => card.remove(), 12000);
            }

            // MODAL & FORM PETUNJUK (WARGA TO PETUGAS)
            const clueModal = document.getElementById('clue-modal');
            window.openClueModal = function(targetId, title) {
                document.getElementById('clue-target-id').value = targetId;
                clueModal.style.display = 'flex';
            };
            document.getElementById('btn-close-clue-modal').addEventListener('click', () => clueModal.style.display = 'none');

            document.getElementById('form-send-clue').addEventListener('submit', function(e) {
                e.preventDefault();
                const session = getSession();
                const targetId = document.getElementById('clue-target-id').value;

                const newClue = {
                    id: Date.now().toString(),
                    targetId: targetId,
                    location: document.getElementById('clue-location').value,
                    note: document.getElementById('clue-note').value,
                    senderName: session ? session.fullname : 'Warga Anonim',
                    senderContact: session ? session.email : '-',
                    createdAt: new Date().toLocaleString()
                };

                saveClue(newClue);
                alert('Petunjuk lokasi telah berhasil dikirimkan ke Panel Petugas Penegak!');
                this.reset();
                clueModal.style.display = 'none';
                renderAllData();
            });

            // SUBMIT MAIN PENGADUAN
            document.getElementById('main-report-form').addEventListener('submit', function(e) {
                e.preventDefault();
                const session = getSession();
                if (!session) { alert('Silakan login terlebih dahulu.'); openModal(); return; }

                const newReport = {
                    code: `LK-${Date.now().toString().slice(-6)}`,
                    category: document.getElementById('report-category').value,
                    title: document.getElementById('report-title').value,
                    description: document.getElementById('report-description').value,
                    location: document.getElementById('location-name').value,
                    reporterName: session.fullname,
                    reporterEmail: session.email,
                    status: 'reported'
                };

                saveReportSync(newReport);
                this.reset();
                alert('Laporan Pengaduan Berhasil Terkirim!');
                navigateTo('laporan-terbaru');
            });

            // RENDER DATA METRIK & KARTU
            function renderAllData() {
                const reports = getReportsSync();
                const lostItems = getLostItems();
                const clues = getClues();
                const session = getSession();

                // 1. RENDER DAFTAR HILANG (PUBLIC)
                const lostListContainer = document.getElementById('lost-items-list');
                if (lostListContainer) {
                    lostListContainer.innerHTML = lostItems.length ? lostItems.map(item => `
                        <article class="report-card" style="border-top: 5px solid var(--color-danger);">
                            <header style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap;">
                                <div>
                                    <span class="badge-urgency urgency-Darurat">${item.type}</span>
                                    <h3 style="margin-top:0.4rem;">${item.title}</h3>
                                </div>
                                <small style="color:var(--color-text-muted);">Kontak: ${item.contact}</small>
                            </header>
                            <hr style="border:none; border-top:1px solid var(--color-border); margin:0.6rem 0;">
                            <p><strong>📍 Terakhir Terlihat:</strong> ${item.lastSeen}</p>
                            <p><strong>Detail Ciri-ciri:</strong> ${item.description}</p>
                            ${item.photo ? `<img src="${item.photo}" class="preview-img" alt="Foto Hilang">` : ''}
                            <div style="margin-top: 1rem;">
                                <button type="button" class="btn-warning btn-sm" onclick="openClueModal('${item.id}', '${item.title}')">💡 Beri Petunjuk / Info Melihat</button>
                            </div>
                        </article>
                    `).join('') : '<p>Belum ada laporan orang atau benda hilang aktif.</p>';
                }

                // 2. RENDER PETUNJUK LOKASI DI DASBOR PETUGAS
                const officerClueContainer = document.getElementById('officer-clues-list');
                if (officerClueContainer && session && session.role === 'officer') {
                    officerClueContainer.innerHTML = clues.length ? clues.map(c => `
                        <article class="report-card" style="border-left: 5px solid var(--color-warning); background: #fffbebf5;">
                            <h4>📍 Petunjuk Lokasi Baru dari: ${c.senderName} (${c.senderContact})</h4>
                            <p style="margin-top:0.4rem;"><strong>Lokasi Dilihat:</strong> ${c.location}</p>
                            <p><strong>Keterangan tambahan:</strong> ${c.note}</p>
                            <small style="color:var(--color-text-muted);">Waktu Kirim: ${c.createdAt}</small>
                            <div style="margin-top:0.5rem;">
                                <button type="button" class="btn-primary btn-sm" onclick="alert('Instruksi dikirim ke tim lapangan untuk meluncur ke lokasi: ${c.location}')">🚔 Meluncur ke Lokasi</button>
                            </div>
                        </article>
                    `).join('') : '<p>Belum ada petunjuk lokasi dari warga.</p>';
                }

                // 3. RENDER PENGADUAN WARGA
                const renderCard = (r) => `
                    <article class="report-card">
                        <header style="display:flex; justify-content:space-between; align-items:flex-start;">
                            <div>
                                <small style="color:var(--color-text-muted);">ID: ${r.code || r.id} | Pelapor: ${r.reporterName}</small>
                                <h3 style="margin-top:0.2rem;">${r.title}</h3>
                            </div>
                            <span class="status status-${r.status}">${r.status.toUpperCase()}</span>
                        </header>
                        <hr style="border:none; border-top:1px solid var(--color-border); margin:0.6rem 0;">
                        <p><strong>Kategori:</strong> ${r.category} | 📍 ${r.location}</p>
                        <p>${r.description}</p>
                    </article>`;

                const allList = document.getElementById('all-reports-list');
                if (allList) allList.innerHTML = reports.length ? reports.map(renderCard).join('') : '<p>Belum ada laporan.</p>';

                const myList = document.getElementById('my-reports-list');
                if (myList && session && session.role === 'warga') {
                    const myReports = reports.filter(r => r.reporterEmail === session.email);
                    myList.innerHTML = myReports.length ? myReports.map(renderCard).join('') : '<p>Kamu belum memiliki riwayat pengaduan.</p>';
                }

                const officerList = document.getElementById('officer-reports-list');
                if (officerList && session && session.role === 'officer') {
                    officerList.innerHTML = reports.length ? reports.map(renderCard).join('') : '<p>Tidak ada pengaduan masuk.</p>';
                }
            }

            // NAVIGATION ROUTING EVENT
            document.addEventListener('click', (e) => {
                const link = e.target.closest('.nav-link');
                if (link) {
                    e.preventDefault();
                    navigateTo(link.getAttribute('data-target'));
                }
            });

            // INITIALIZATION
            updateAuthUI();
            navigateTo('beranda');
        })();
    </script>
</body>
</html>
