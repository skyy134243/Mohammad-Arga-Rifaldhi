/* =========================================================
   LAPORKITA
   Civic-Tech Platform
   Pure CSS UI System
   ========================================================= */


/* =========================================================
   01. CSS VARIABLES
   ========================================================= */

:root {
    --color-primary: #16794a;
    --color-primary-dark: #0f5d39;
    --color-primary-light: #e8f5ee;

    --color-background: #f5f7f6;
    --color-surface: #ffffff;
    --color-surface-soft: #f8faf9;

    --color-text: #17221c;
    --color-text-secondary: #46534c;
    --color-text-muted: #718078;

    --color-border: #dce4df;
    --color-border-strong: #c7d2cc;

    --color-success: #16804b;
    --color-success-bg: #e7f6ed;

    --color-warning: #a56a00;
    --color-warning-bg: #fff5d9;

    --color-info: #1769aa;
    --color-info-bg: #e8f2fb;

    --color-danger: #b43a3a;
    --color-danger-bg: #fbeaea;

    --color-closed: #69736e;
    --color-closed-bg: #edf0ee;

    --color-white: #ffffff;
    --color-black: #111713;

    --shadow-sm: 0 1px 3px rgba(20, 38, 29, 0.06);
    --shadow-md: 0 6px 20px rgba(20, 38, 29, 0.08);
    --shadow-lg: 0 12px 32px rgba(20, 38, 29, 0.10);

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-xl: 22px;

    --container-width: 1240px;

    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-20: 5rem;

    --transition-fast: 120ms ease;
    --transition-normal: 180ms ease;
}


/* =========================================================
   02. RESET
   ========================================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body,
h1,
h2,
h3,
h4,
h5,
h6,
p,
figure,
blockquote,
dl,
dd,
ul,
ol {
    margin: 0;
}

ul,
ol {
    padding: 0;
    list-style: none;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

img,
svg,
video {
    display: block;
    max-width: 100%;
}

img {
    height: auto;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
select,
textarea {
    border-radius: var(--radius-sm);
}


/* =========================================================
   03. BASE
   ========================================================= */

body {
    min-width: 320px;
    background: var(--color-background);
    color: var(--color-text);
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
}

::selection {
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
}

main {
    width: 100%;
}

section {
    width: 100%;
}

main > section,
main > .page {
    max-width: var(--container-width);
    margin-inline: auto;
    padding: var(--space-12) var(--space-6);
}

.page {
    scroll-margin-top: 5rem;
}

.page-header {
    margin-bottom: var(--space-8);
}

.page-header p {
    max-width: 720px;
}

strong {
    font-weight: 700;
}


/* =========================================================
   04. TYPOGRAPHY
   ========================================================= */

h1,
h2,
h3,
h4,
h5,
h6 {
    color: var(--color-text);
    font-weight: 700;
    line-height: 1.2;
}

h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    letter-spacing: -0.035em;
}

h2 {
    font-size: clamp(1.4rem, 2vw, 2rem);
    letter-spacing: -0.02em;
}

h3 {
    font-size: 1.05rem;
}

p {
    color: var(--color-text-secondary);
}

small,
figcaption,
.caption {
    color: var(--color-text-muted);
    font-size: 0.875rem;
}

.platform-label,
.staff-identity,
.metadata,
.report-card header p,
.staff-report-card header p,
.verification-card header p {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.025em;
}

.platform-label {
    margin-bottom: var(--space-3);
    color: var(--color-primary);
    text-transform: uppercase;
}


/* =========================================================
   05. GLOBAL LAYOUT
   ========================================================= */

.brand {
    flex-shrink: 0;
}

.brand a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
}

.logo-placeholder {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface-soft);
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 800;
}

.page > header:not(.page-header),
.page > section > header {
    margin-bottom: var(--space-6);
}

.page > header:not(.page-header) p {
    margin-top: var(--space-3);
}

.page > section + section {
    margin-top: var(--space-12);
}


/* =========================================================
   06. HEADER
   ========================================================= */

#site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 4.5rem;
    padding: 0 var(--space-6);
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow-sm);
}

#site-header .header-account {
    justify-self: end;
}

#site-header .header-account a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-primary-dark);
    font-weight: 600;
}


/* =========================================================
   07. NAVIGATION
   ========================================================= */

#site-header nav ul,
.staff-header + nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-2);
}

#site-header nav a,
.staff-header + nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    font-weight: 600;
    transition:
        background-color var(--transition-fast),
        color var(--transition-fast);
}

#site-header nav a:hover,
#site-header nav a:focus-visible,
.staff-header + nav a:hover,
.staff-header + nav a:focus-visible {
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
}

#site-header nav a[aria-current="page"],
.staff-header + nav a[aria-current="page"] {
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
}

nav[aria-label="Breadcrumb"] {
    margin-bottom: var(--space-6);
}

nav[aria-label="Breadcrumb"] ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.875rem;
}

nav[aria-label="Breadcrumb"] li:not(:last-child)::after {
    content: "/";
    margin-left: var(--space-2);
    color: var(--color-border-strong);
}

nav[aria-label="Breadcrumb"] a:hover {
    color: var(--color-primary);
}


/* =========================================================
   08. HERO
   ========================================================= */

#beranda > .page-header {
    padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 5vw, 5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
}

#beranda > .page-header h1 {
    max-width: 760px;
}

#beranda > .page-header > p {
    max-width: 680px;
    margin-top: var(--space-5);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
}

.hero-actions a,
.form-actions button,
form > button,
.report-category footer a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-white);
    font-weight: 700;
    transition:
        background-color var(--transition-fast),
        border-color var(--transition-fast);
}

.hero-actions a:hover,
.hero-actions a:focus-visible,
.form-actions button:hover,
.form-actions button:focus-visible,
form > button:hover,
form > button:focus-visible,
.report-category footer a:hover,
.report-category footer a:focus-visible {
    background: var(--color-primary-dark);
    border-color: var(--color-primary-dark);
}

.hero-actions a:nth-child(2) {
    background: var(--color-surface);
    color: var(--color-primary-dark);
}


/* =========================================================
   09. SEARCH
   ========================================================= */

#search-section {
    margin-top: var(--space-10);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
}

#search-section form,
.report-search {
    display: flex;
    gap: var(--space-3);
}

#search-section label,
.report-search label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

#search-section input,
.report-search input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
}


/* =========================================================
   10. FORM CONTROLS
   ========================================================= */

input,
select,
textarea {
    width: 100%;
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text);
    outline: none;
}

input,
select {
    min-height: 2.75rem;
    padding: 0.6rem 0.8rem;
}

textarea {
    min-height: 8rem;
    padding: 0.75rem 0.8rem;
    resize: vertical;
}

input::placeholder,
textarea::placeholder {
    color: var(--color-text-muted);
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
}

input[type="checkbox"],
input[type="radio"] {
    width: auto;
    min-height: auto;
    accent-color: var(--color-primary);
}

label {
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
}


/* =========================================================
   11. BUTTONS
   ========================================================= */

button {
    border: 1px solid transparent;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
    outline: 3px solid rgba(22, 121, 74, 0.25);
    outline-offset: 2px;
}

button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
}

.form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
}

.form-actions button[type="reset"] {
    border-color: var(--color-border-strong);
    background: var(--color-surface);
    color: var(--color-text-secondary);
}


/* =========================================================
   12. CATEGORY CARDS
   ========================================================= */

.report-category-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
}

.report-category {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
}

.report-category::before {
    content: "CATEGORY";
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 1.75rem;
    margin-bottom: var(--space-5);
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
}

.report-category h3 {
    margin-bottom: var(--space-4);
}

.report-category ul {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
}

.report-category li {
    position: relative;
    padding-left: 1rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
}

.report-category li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-primary);
}

.report-category aside {
    margin-bottom: var(--space-5);
    padding: var(--space-3);
    border-left: 3px solid var(--color-warning);
    background: var(--color-warning-bg);
}

.report-category aside p {
    font-size: 0.85rem;
}

.report-category footer {
    margin-top: auto;
}

.report-category footer a {
    width: 100%;
}


/* =========================================================
   13. STATISTICS
   ========================================================= */

.statistics-summary,
.performance-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
}

.statistics-summary article,
.performance-summary article,
.account-statistics dl > div {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
}

.statistics-summary h3,
.performance-summary h2 {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 600;
}

.statistics-summary data,
.performance-summary data,
.account-statistics dd {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-text);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.1;
}

.statistics-visualization,
.staff-dashboard-charts,
.statistics-charts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
}

figure {
    min-width: 0;
}

figure figcaption {
    margin-bottom: var(--space-3);
    font-weight: 600;
}

.chart-placeholder,
.map-placeholder,
.image-placeholder,
.avatar-placeholder,
.empty-state-placeholder,
.loading-placeholder,
.error-placeholder {
    display: grid;
    min-height: 180px;
    place-items: center;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-soft);
    color: var(--color-text-muted);
    text-align: center;
}


/* =========================================================
   14. REPORT CARDS
   ========================================================= */

.latest-report-list,
.report-list,
.my-report-list,
.nearby-report-list,
.processing-report-list,
.verification-queue,
.similar-report-list {
    display: grid;
    gap: var(--space-5);
}

.report-card,
.my-report-card,
.staff-report-card,
.verification-card,
.processing-report-list article,
.similar-report-list article {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
}

.report-card > header,
.my-report-card > header,
.staff-report-card > header,
.verification-card > header,
.processing-report-list article > header {
    margin-bottom: var(--space-4);
}

.report-card h2,
.report-card h3,
.my-report-card h3,
.staff-report-card h2,
.verification-card h2,
.processing-report-list h2 {
    margin-top: var(--space-1);
}

.report-card figure {
    margin-bottom: var(--space-5);
}

.report-card .image-placeholder {
    min-height: 220px;
}

.report-card dl,
.my-report-card dl,
.staff-report-card dl,
.verification-card dl,
.processing-report-list dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-6);
    margin-bottom: var(--space-5);
}

.report-card dt,
.my-report-card dt,
.staff-report-card dt,
.verification-card dt,
.processing-report-list dt,
.report-identity dt,
.staff-profile-information dt {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
}

.report-card dd,
.my-report-card dd,
.staff-report-card dd,
.verification-card dd,
.processing-report-list dd,
.report-identity dd,
.staff-profile-information dd {
    color: var(--color-text-secondary);
}

.report-card > a,
.my-report-card > a,
.staff-report-card > a,
.similar-report-list a {
    display: inline-flex;
    color: var(--color-primary-dark);
    font-weight: 700;
}

.report-card > a:hover,
.my-report-card > a:hover,
.staff-report-card > a:hover,
.similar-report-list a:hover {
    text-decoration: underline;
}


/* =========================================================
   15. STATUS BADGES
   ========================================================= */

.status {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.2;
}

.status-dilaporkan,
.status-reported {
    background: var(--color-warning-bg);
    border-color: #efd48d;
    color: var(--color-warning);
}

.status-diverifikasi,
.status-verified {
    background: var(--color-info-bg);
    border-color: #bdd8ed;
    color: var(--color-info);
}

.status-diteruskan,
.status-forwarded {
    background: #edf1f7;
    border-color: #ced8e5;
    color: #455f7c;
}

.status-penanganan,
.status-processing {
    background: var(--color-warning-bg);
    border-color: #efd48d;
    color: var(--color-warning);
}

.status-selesai,
.status-completed {
    background: var(--color-success-bg);
    border-color: #b9dfca;
    color: var(--color-success);
}

.status-ditutup,
.status-closed {
    background: var(--color-closed-bg);
    border-color: var(--color-border);
    color: var(--color-closed);
}


/* =========================================================
   16. FORMS
   ========================================================= */

.page-report-form > form {
    max-width: 900px;
    margin-inline: auto;
}

fieldset {
    min-width: 0;
    margin: 0 0 var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
}

legend {
    padding-inline: var(--space-3);
    color: var(--color-text);
    font-weight: 750;
}

.form-field {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
}

.form-field:last-child {
    margin-bottom: 0;
}

fieldset > .form-field + .form-field {
    margin-top: var(--space-5);
}

.form-field:has(input[type="checkbox"]),
.form-field:has(input[type="radio"]) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
}

.form-field:has(input[type="file"]) input {
    padding: var(--space-3);
}

.form-notice {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-primary-light);
}

.form-notice p {
    color: var(--color-primary-dark);
    font-size: 0.9rem;
    font-weight: 600;
}


/* =========================================================
   17. UPLOAD
   ========================================================= */

input[type="file"] {
    min-height: 4.5rem;
    border: 2px dashed var(--color-border-strong);
    background: var(--color-surface-soft);
    cursor: pointer;
}

input[type="file"]:focus {
    border-color: var(--color-primary);
}


/* ============================
