<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LAPORKITA - System Civic-Tech & Panel Penegak Hukum</title>
    
    <style>
        :root {
            --color-primary: #16794a;
            --color-primary-dark: #0f5d39;
            --color-primary-light: #e8f5ee;
            --color-background: #f5f7f6;
            --color-surface: #ffffff;
            --color-surface-soft: #f8faf9;
            --color-text: #17221c;
            --color-text-secondary: #46534c;
            --color-text-muted: #718078;
            --color-border: #dce4df;
            --color-border-strong: #c7d2cc;
            --color-success: #16804b;
            --color-success-bg: #e7f6ed;
            --color-warning: #a56a00;
            --color-warning-bg: #fff5d9;
            --color-danger: #b43a3a;
            --color-danger-bg: #fbeaea;
            --color-white: #ffffff;
            --shadow-sm: 0 1px 3px rgba(20, 38, 29, 0.06);
            --shadow-md: 0 6px 20px rgba(20, 38, 29, 0.08);
            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 16px;
            --radius-xl: 22px;
            --container-width: 1240px;
            --space-2: 0.5rem;
            --space-3: 0.75rem;
            --space-4: 1rem;
            --space-5: 1.25rem;
            --space-6: 1.5rem;
            --space-8: 2rem;
            --space-12: 3rem;
            --transition-fast: 120ms ease;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; font-size: 16px; }
        body, h1, h2, h3, h4, h5, h6, p, figure, ul, ol { margin: 0; }
        ul, ol { padding: 0; list-style: none; }
        button, input, select, textarea { font: inherit; border-radius: var(--radius-sm); }
        button { cursor: pointer; border: 1px solid transparent; }
        img { display: block; max-width: 100%; height: auto; }
        a { color: inherit; text-decoration: none; }

        body {
            min-width: 320px; background: var(--color-background); color: var(--color-text);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif; font-size: 1rem; line-height: 1.6;
        }

        main > section, main > .page { max-width: var(--container-width); margin-inline: auto; padding: var(--space-8) var(--space-6); }
        .page { animation: fadeIn 200ms ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

        .page-header { margin-bottom: var(--space-8); }
        .page-header p { max-width: 720px; }
        strong { font-weight: 700; }
        h1, h2, h3, h4 { color: var(--color-text); font-weight: 700; line-height: 1.2; }
        h1 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.03em; }
        h2 { font-size: clamp(1.3rem, 2vw, 1.8rem); margin-bottom: var(--space-4); }
        h3 { font-size: 1.05rem; }
        p { color: var(--color-text-secondary); }

        .platform-label { margin-bottom: var(--space-2); color: var(--color-primary); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; }

        /* HEADER & NAVIGATION */
        .brand a { display: inline-flex; align-items: center; gap: var(--space-3); font-size: 1.15rem; font-weight: 800; }
        .logo-placeholder {
            display: inline-grid; width: 2.25rem; height: 2.25rem; place-items: center;
            border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm);
            background: var(--color-surface-soft); color: var(--color-primary); font-size: 0.75rem; font-weight: 800;
        }

        #site-header {
            position: sticky; top: 0; z-index: 100;
            display: flex; justify-content: space-between; align-items: center;
            min-height: 4.5rem; padding: 0 var(--space-6);
            border-bottom: 1px solid var(--color-border); background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(8px);
            box-shadow: var(--shadow-sm);
        }

        #site-header nav ul { display: flex; align-items: center; gap: var(--space-2); }
        #site-header nav a {
            display: inline-flex; align-items: center; min-height: 2.4rem; padding: 0 var(--space-4);
            border-radius: var(--radius-md); color: var(--color-text-secondary); font-size: 0.9rem; font-weight: 600;
            transition: background-color var(--transition-fast), color var(--transition-fast);
        }
        #site-header nav a:hover, #site-header nav a[aria-current="page"] { background: var(--color-primary-light); color: var(--color-primary-dark); }

        /* BUTTONS */
        .btn-primary, .btn-secondary, .btn-danger, .btn-warning {
            display: inline-flex; align-items: center; justify-content: center;
            min-height: 2.6rem; padding: 0.5rem 1.1rem;
            border-radius: var(--radius-md); font-weight: 700; font-size: 0.9rem;
            transition: all var(--transition-fast); cursor: pointer;
        }
        .btn-primary { background: var(--color-primary); color: var(--color-white); border: 1px solid var(--color-primary); }
        .btn-primary:hover { background: var(--color-primary-dark); }
        .btn-secondary { background: var(--color-surface); color: var(--color-primary-dark); border: 1px solid var(--color-border-strong); }
        .btn-secondary:hover { background: var(--color-surface-soft); }
        .btn-danger { background: var(--color-danger); color: var(--color-white); border: 1px solid var(--color-danger); }
        .btn-warning { background: var(--color-warning); color: var(--color-white); border: 1px solid var(--color-warning); }
        .btn-sm { min-height: 2rem; padding: 0.3rem 0.75rem; font-size: 0.8rem; }

        /* CARDS & PROGRESS BARS */
        .statistics-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-4); }
        .statistics-summary article { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
        .statistics-summary data { display: block; margin-top: var(--space-2); font-size: 1.8rem; font-weight: 800; color: var(--color-primary); }

        .stat-card-box { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); margin-bottom: 1.5rem; }
        .progress-bar-bg { width: 100%; height: 14px; background: var(--color-border); border-radius: 999px; overflow: hidden; margin: 0.5rem 0 1.2rem; }
        .progress-bar-fill { height: 100%; background: var(--color-primary); width: 0%; transition: width 0.4s ease; }

        /* FORMS & INPUTS */
        fieldset { margin-bottom: var(--space-6); padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
        legend { padding-inline: var(--space-2); font-weight: 700; color: var(--color-primary-dark); }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); }
        .form-field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: var(--space-4); }
        label { font-weight: 600; font-size: 0.875rem; color: var(--color-text); }
        input, select, textarea { width: 100%; border: 1px solid var(--color-border-strong); background: var(--color-surface); color: var(--color-text); padding: 0.65rem 0.8rem; border-radius: var(--radius-sm); outline: none; }
        textarea { min-height: 7rem; resize: vertical; }
        input:focus, select:focus, textarea:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-light); }

        /* LIST & BADGES */
        .latest-report-list { display: grid; gap: var(--space-4); }
        .report-card { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-sm); }
        .status { display: inline-flex; padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
        .status-reported { background: var(--color-warning-bg); color: var(--color-warning); }
        .status-process { background: #e0f2fe; color: #0369a1; }
        .status-completed { background: var(--color-success-bg); color: var(--color-success); }
        .badge-urgency { padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; }
        .urgency-Biasa { background: #e2e8f0; color: #334155; }
        .urgency-Penting { background: #fef08a; color: #854d0e; }
        .urgency-Darurat { background: var(--color-danger-bg); color: var(--color-danger); }
        .preview-img { max-height: 140px; border-radius: var(--radius-md); margin-top: 0.5rem; display: none; border: 1px solid var(--color-border); }

        /* MODAL AUTHENTICATION */
        .modal { position: fixed; inset: 0; z-index: 1000; display: none; align-items: center; justify-content: center; background: rgba(17, 23, 19, 0.6); backdrop-filter: blur(4px); padding: 1rem; }
        .modal-content { position: relative; background: var(--color-surface); padding: var(--space-6); border-radius: var(--radius-lg); max-width: 480px; width: 100%; box-shadow: var(--shadow-md); max-height: 90vh; overflow-y: auto; }
        .auth-tabs { display: flex; border-bottom: 2px solid var(--color-border); margin-bottom: var(--space-5); }
        .auth-tab-btn { flex: 1; padding: var(--space-3); border: none; background: none; font-weight: 700; color: var(--color-text-muted); cursor: pointer; font-size: 0.85rem; }
        .auth-tab-btn.active { border-bottom: 3px solid var(--color-primary); color: var(--color-primary); }

        footer.site-footer { text-align: center; padding: var(--space-8) var(--space-6); border-top: 1px solid var(--color-border); margin-top: var(--space-12); background: var(--color-surface); color: var(--color-text-muted); font-size: 0.875rem; }
    </style>
</head>

<body>

    <!-- GLOBAL HEADER -->
    <header id="site-header">
        <div class="brand">
            <a href="#beranda" class="nav-link" data-target="beranda">
                <span class="logo-placeholder">LK</span>
                <span>LAPORKITA</span>
            </a>
        </div>

        <nav aria-label="Navigasi utama">
            <ul>
                <li><a href="#beranda" class="nav-link" data-target="beranda">Beranda</a></li>
                <li><a href="#halaman-statistik" class="nav-link" data-target="halaman-statistik">Statistik & Polling</a></li>
                <li><a href="#laporan-terbaru" class="nav-link" data-target="laporan-terbaru">Laporan Warga</a></li>
                <li><a href="#formulir-laporan" class="nav-link" data-target="formulir-laporan">Buat Laporan</a></li>
                <li id="nav-item-citizen-dash" style="display: none;"><a href="#akun-masyarakat" class="nav-link" data-target="akun-masyarakat">Laporan Saya</a></li>
                <li id="nav-item-officer-dash" style="display: none;"><a href="#dasbor-petugas" class="nav-link" data-target="dasbor-petugas" style="color:var(--color-danger); border:1px solid var(--color-border);">🛡️ Panel Petugas</a></li>
            </ul>
        </nav>

        <div id="auth-header-action">
            <button type="button" id="btn-open-auth" class="btn-secondary btn-sm">Masuk / Daftar</button>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main id="main-content">

        <!-- 01. BERANDA -->
        <section id="beranda" class="page">
            <header class="page-header" style="padding: 2.5rem; background: var(--color-surface); border:1px solid var(--color-border); border-radius: var(--radius-xl);">
                <p class="platform-label">Platform Civic-Tech & Penegakan Hukum Terintegrasi</p>
                <h1>Laporkan & Pantau Penanganan Masalah Wilayahmu</h1>
                <p>Platform transparansi warga dan petugas untuk mempercepat penanganan fasilitas umum, ketertiban, dan kebersihan secara akuntabel.</p>
                <div style="display:flex; gap:1rem; margin-top:1.5rem;">
                    <a href="#formulir-laporan" class="nav-link btn-primary" data-target="formulir-laporan">📝 Buat Laporan Pengaduan</a>
                    <a href="#halaman-statistik" class="nav-link btn-secondary" data-target="halaman-statistik">📊 Lihat Grafik & Polling</a>
                </div>
            </header>

            <section style="margin-top: 2.5rem;">
                <h2>Laporan Warga Terbaru</h2>
                <div class="latest-report-list" id="home-report-list"></div>
            </section>
        </section>

        <!-- 02. HALAMAN DEDICATED STATISTIK & POLLING -->
        <section id="halaman-statistik" class="page" style="display: none;">
            <header class="page-header">
                <h1>Statistik Real-Time & Polling Warga</h1>
                <p>Visualisasi grafik penanganan laporan (Sudah Dibenahi vs Belum Dibenahi) serta polling partisipasi masyarakat.</p>
            </header>

            <!-- CARD REKAP ANGKA -->
            <div class="statistics-summary" style="margin-bottom: 2rem;">
                <article><h3>Total Masuk</h3><data id="stat-total">0</data></article>
                <article><h3>Belum Dibenahi</h3><data id="stat-reported" style="color:var(--color-danger)">0</data></article>
                <article><h3>Sedang Diproses</h3><data id="stat-process" style="color:var(--color-warning)">0</data></article>
                <article><h3>Sudah Dibenahi</h3><data id="stat-completed" style="color:var(--color-success)">0</data></article>
            </div>

            <div class="form-grid">
                <!-- GRAFIK STATUS PENANGANAAN (SUDAH VS BELUM DIBENAHI) -->
                <div class="stat-card-box">
                    <h2>📊 Grafik Progres Penanganan Masalah</h2>
                    <p><small>Perbandingan status fisik tindak lanjut oleh petugas</small></p>
                    
                    <div style="margin-top: 1.5rem;">
                        <div style="display:flex; justify-content:space-between;">
                            <strong>✅ Sudah Dibenahi / Selesai</strong>
                            <span id="rate-completed-text">0%</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div id="bar-completed" class="progress-bar-fill" style="background: var(--color-success);"></div>
                        </div>

                        <div style="display:flex; justify-content:space-between;">
                            <strong>🚧 Sedang Dikerjakan (Dalam Proses)</strong>
                            <span id="rate-process-text">0%</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div id="bar-process" class="progress-bar-fill" style="background: var(--color-warning);"></div>
                        </div>

                        <div style="display:flex; justify-content:space-between;">
                            <strong>⏳ Belum Dibenahi (Verifikasi Awal)</strong>
                            <span id="rate-reported-text">0%</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div id="bar-reported" class="progress-bar-fill" style="background: var(--color-danger);"></div>
                        </div>
                    </div>
                </div>

                <!-- POLLING PUBLIC INTEGRATED -->
                <div class="stat-card-box">
                    <h2>🗳️ Polling Warga: Efektivitas Petugas</h2>
                    <p><small>Bagaimana pendapat kamu mengenai kecepatan penanganan laporan bulan ini?</small></p>
                    
                    <form id="form-polling" style="margin-top: 1rem;">
                        <div style="display:grid; gap:0.5rem; margin-bottom: 1rem;">
                            <label><input type="radio" name="poll" value="sangat_puas" checked> 🟢 Sangat Cepat & Tanggap</label>
                            <label><input type="radio" name="poll" value="cukup"> 🟡 Cukup Baik (Sedang)</label>
                            <label><input type="radio" name="poll" value="kurang"> 🔴 Lambat / Perlu Ditingkatkan</label>
                        </div>
                        <button type="submit" class="btn-primary btn-sm" style="width:100%;">Kirim Suara Polling</button>
                    </form>

                    <div style="margin-top: 1.5rem; border-top: 1px dashed var(--color-border); padding-top: 1rem;">
                        <h4>Hasil Polling Sementara (<span id="total-votes">0</span> Suara):</h4>
                        <div style="margin-top: 0.5rem; font-size: 0.85rem;">
                            <div>Sangat Cepat: <strong id="poll-res-1">0</strong> suara</div>
                            <div>Cukup Baik: <strong id="poll-res-2">0</strong> suara</div>
                            <div>Lambat: <strong id="poll-res-3">0</strong> suara</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03. LAPORAN TERBARU WARGA -->
        <section id="laporan-terbaru" class="page" style="display: none;">
            <header class="page-header">
                <h1>Kumpulan Laporan Pengaduan</h1>
                <p>Daftar transparan pengaduan warga secara terbuka.</p>
            </header>
            <div class="latest-report-list" id="all-reports-list"></div>
        </section>

        <!-- 04. FORMULIR LAPORAN -->
        <section id="formulir-laporan" class="page" style="display: none;">
            <header class="page-header">
                <h1>Buat Laporan Pengaduan Baru</h1>
                <p>Isi formulir berikut dengan akurat untuk ditindaklanjuti oleh satuan petugas terkait.</p>
            </header>

            <form id="main-report-form">
                <fieldset>
                    <legend>Detail Masalah & Identitas</legend>
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="report-category">Kategori Utama *</label>
                            <select id="report-category" required>
                                <option value="">-- Pilih Kategori --</option>
                                <option value="Fasilitas Publik">Fasilitas Publik</option>
                                <option value="Ketertiban & Pungli">Ketertiban & Pungli</option>
                                <option value="Kebersihan & Lingkungan">Kebersihan & Lingkungan</option>
                                <option value="Pelayanan Publik">Pelayanan Publik</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="report-urgency">Tingkat Kedaruratan *</label>
                            <select id="report-urgency" required>
                                <option value="Biasa">🟢 Biasa</option>
                                <option value="Penting">🟡 Penting</option>
                                <option value="Darurat">🔴 Darurat (Bahaya)</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="report-title">Judul Laporan *</label>
                        <input type="text" id="report-title" required placeholder="Jalan berlubang parah di RT 03">
                    </div>

                    <div class="form-field">
                        <label for="report-description">Deskripsi Lengkap *</label>
                        <textarea id="report-description" required placeholder="Tuliskan kronologi dan patokan lokasi detail..."></textarea>
                    </div>

                    <div class="form-grid">
                        <div class="form-field">
                            <label for="location-name">Patokan Alamat Detail *</label>
                            <input type="text" id="location-name" required placeholder="Jl. Merdeka No. 12 Depan Toko">
                        </div>
                        <div class="form-field">
                            <label for="report-photo">Foto Bukti Lapangan *</label>
                            <input type="file" id="report-photo" accept="image/*" required>
                            <img id="photo-preview" class="preview-img" alt="Preview Foto">
                        </div>
                    </div>
                </fieldset>
                <button type="submit" class="btn-primary" style="width:100%;">🚀 Kirimkan Pengaduan</button>
            </form>
        </section>

        <!-- 05. DASBOR WARGA -->
        <section id="akun-masyarakat" class="page" style="display: none;">
            <header class="page-header">
                <h1>Dashboard Pengaduan Saya</h1>
                <p>Riwayat status laporan yang pernah kamu kirimkan.</p>
            </header>
            <div id="my-reports-list" class="latest-report-list"></div>
        </section>

        <!-- 06. DASBOR PETUGAS (TERSUSUN RAPI DENGAN AKSES PENEGAK) -->
        <section id="dasbor-petugas" class="page" style="display: none;">
            <header class="page-header" style="border-left: 5px solid var(--color-danger); padding-left: 1rem;">
                <p class="platform-label" style="color:var(--color-danger);">Akses Otentikasi Terverifikasi Petugas</p>
                <h1>🛡️ Panel Kontrol Penegak Hukum & Petugas</h1>
                <p>Kelola verifikasi, ubah status perbaikan fisik (Sudah Dibenahi/Belum), dan hapus laporan tidak valid.</p>
            </header>
            <div id="officer-reports-list" class="latest-report-list"></div>
        </section>

    </main>

    <!-- MODAL AUTHENTICATION & REGISTRASI VERIFIKASI PETUGAS -->
    <div id="auth-modal" class="modal">
        <div class="modal-content">
            <div class="auth-tabs">
                <button type="button" class="auth-tab-btn active" id="tab-btn-login">Masuk (Login)</button>
                <button type="button" class="auth-tab-btn" id="tab-btn-reg-warga">Daftar Warga</button>
                <button type="button" class="auth-tab-btn" id="tab-btn-reg-officer" style="color:var(--color-danger);">🛡️ Daftar Petugas</button>
            </div>

            <!-- FORM 1: LOGIN -->
            <form id="form-login">
                <h2>Masuk Akun</h2>
                <div class="form-field" style="margin-top:1rem;">
                    <label for="login-email">Email / Username / NIP Petugas</label>
                    <input type="text" id="login-email" required placeholder="email / NIP Petugas">
                </div>
                <div class="form-field">
                    <label for="login-password">Kata Sandi</label>
                    <input type="password" id="login-password" required placeholder="Masukkan kata sandi">
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem;">Masuk Sekarang</button>
            </form>

            <!-- FORM 2: REGISTRASI WARGA -->
            <form id="form-reg-warga" style="display: none;">
                <h2>Daftar Akun Masyakarat</h2>
                <div class="form-field" style="margin-top: 1rem;">
                    <label for="regw-name">Nama Lengkap *</label>
                    <input type="text" id="regw-name" required placeholder="Sesuai KTP">
                </div>
                <div class="form-field">
                    <label for="regw-email">Alamat Email *</label>
                    <input type="email" id="regw-email" required placeholder="nama@email.com">
                </div>
                <div class="form-field">
                    <label for="regw-pass">Kata Sandi *</label>
                    <input type="password" id="regw-pass" required placeholder="Min 6 Karakter">
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem;">Daftar Akun Warga</button>
            </form>

            <!-- FORM 3: REGISTRASI PETUGAS + VERIFIKASI KARTU & KODE -->
            <form id="form-reg-officer" style="display: none;">
                <h2 style="color:var(--color-danger);">Registrasi Petugas Penegak</h2>
                <p style="font-size:0.8rem; color:var(--color-text-muted);">Memerlukan verifikasi kartu identitas resmi & kode otentikasi.</p>
                
                <div class="form-field" style="margin-top: 0.8rem;">
                    <label for="rego-name">Nama Petugas & Gelar *</label>
                    <input type="text" id="rego-name" required placeholder="Contoh: Bripka Susanto">
                </div>
                <div class="form-field">
                    <label for="rego-nip">Nomor Kartu Identitas / NIP / NRP *</label>
                    <input type="text" id="rego-nip" required placeholder="Nomor Induk Petugas Resmi">
                </div>
                <div class="form-field">
                    <label for="rego-email">Email Dinas Petugas *</label>
                    <input type="email" id="rego-email" required placeholder="petugas@instansi.go.id">
                </div>
                <div class="form-field">
                    <label for="rego-idcard">Upload Foto ID Card / KTA Petugas *</label>
                    <input type="file" id="rego-idcard" accept="image/*" required>
                </div>
                <div class="form-field">
                    <label for="rego-pass">Buat Kata Sandi *</label>
                    <input type="password" id="rego-pass" required placeholder="Password Akun Petugas">
                </div>
                <button type="submit" class="btn-danger" style="width: 100%; margin-top: 0.5rem;">Kirim & Minta Kode Otentikasi</button>
            </form>

            <!-- STEP KODE VERIFIKASI PETUGAS -->
            <form id="form-verify-code" style="display: none; background:var(--color-warning-bg); padding:1rem; border-radius:var(--radius-md);">
                <h3>🔒 Masukkan Kode Otentikasi Petugas</h3>
                <p style="font-size:0.8rem; color:var(--color-warning);">Kode verifikasi telah dikirimkan ke email dinas petugas Anda.</p>
                <div class="form-field" style="margin-top: 0.5rem;">
                    <label for="input-verify-code">Kode Verifikasi Petugas *</label>
                    <input type="text" id="input-verify-code" required placeholder="Contoh: OFFICER-1234">
                </div>
                <button type="submit" class="btn-primary" style="width:100%;">Aktivasi & Verifikasi Akun Petugas</button>
            </form>

            <button type="button" id="btn-close-modal" class="btn-secondary btn-sm" style="width: 100%; margin-top: 1rem;">Batal</button>
        </div>
    </div>

    <!-- GLOBAL FOOTER -->
    <footer class="site-footer">
        <p>&copy; 2026 LAPORKITA - Platform Civic-Tech & Penegakan Hukum Terintegrasi.</p>
    </footer>

    <!-- SCRIPT APPLICATION -->
    <script>
        (() => {
            'use strict';
            const STORAGE = { USERS: 'lk_users', SESSION: 'lk_session', REPORTS: 'lk_reports', POLLS: 'lk_polls' };

            function getStorage(key, fallback = []) {
                try { const item = localStorage.getItem(key); return item ? JSON.parse(item) : fallback; } catch(e) { return fallback; }
            }
            function setStorage(key, val) {
                try { localStorage.setItem(key, JSON.stringify(val)); } catch(e) {}
            }

            // Inisialisasi Akun Bawaan (Warga & Petugas)
            if (!localStorage.getItem(STORAGE.USERS)) {
                setStorage(STORAGE.USERS, [
                    { name: 'Mohammad Arga', email: 'arga@test.com', pass: 'password123', role: 'warga' },
                    { name: 'Bripka Susanto (Satgas)', email: 'petugas@polri.go.id', pass: 'password123', role: 'officer', nip: '320199201920', verified: true }
                ]);
            }

            // Inisialisasi Polling Bawaan
            if (!localStorage.getItem(STORAGE.POLLS)) {
                setStorage(STORAGE.POLLS, { sangat_puas: 12, cukup: 5, kurang: 2 });
            }

            function navigateTo(targetId) {
                document.querySelectorAll('.page').forEach(p => p.style.display = 'none');
                const targetPage = document.getElementById(targetId) || document.getElementById('beranda');
                targetPage.style.display = 'block';

                document.querySelectorAll('#site-header nav a').forEach(a => {
                    if (a.getAttribute('data-target') === targetId) a.setAttribute('aria-current', 'page');
                    else a.removeAttribute('aria-current');
                });

                window.scrollTo(0, 0);
                renderAllData();
            }

            // MODAL & AUTH SWITCHER
            const authModal = document.getElementById('auth-modal');
            const tabLogin = document.getElementById('tab-btn-login');
            const tabWarga = document.getElementById('tab-btn-reg-warga');
            const tabOfficer = document.getElementById('tab-btn-reg-officer');

            const formLogin = document.getElementById('form-login');
            const formRegWarga = document.getElementById('form-reg-warga');
            const formRegOfficer = document.getElementById('form-reg-officer');
            const formVerifyCode = document.getElementById('form-verify-code');

            function resetAuthForms() {
                formLogin.style.display = 'none'; formRegWarga.style.display = 'none';
                formRegOfficer.style.display = 'none'; formVerifyCode.style.display = 'none';
                tabLogin.classList.remove('active'); tabWarga.classList.remove('active'); tabOfficer.classList.remove('active');
            }

            tabLogin.addEventListener('click', () => { resetAuthForms(); tabLogin.classList.add('active'); formLogin.style.display = 'block'; });
            tabWarga.addEventListener('click', () => { resetAuthForms(); tabWarga.classList.add('active'); formRegWarga.style.display = 'block'; });
            tabOfficer.addEventListener('click', () => { resetAuthForms(); tabOfficer.classList.add('active'); formRegOfficer.style.display = 'block'; });
            document.getElementById('btn-close-modal').addEventListener('click', () => authModal.style.display = 'none');

            // LOGIN LOGIC
            formLogin.addEventListener('submit', (e) => {
                e.preventDefault();
                const id = document.getElementById('login-email').value.trim();
                const pass = document.getElementById('login-password').value;
                const users = getStorage(STORAGE.USERS, []);

                const user = users.find(u => (u.email === id || u.nip === id) && u.pass === pass);
                if (user) {
                    if (user.role === 'officer' && !user.verified) {
                        alert('Akun Petugas Anda belum diverifikasi dengan kode unik!');
                        return;
                    }
                    setStorage(STORAGE.SESSION, user);
                    alert(`Selamat datang kembali, ${user.name}!`);
                    authModal.style.display = 'none';
                    formLogin.reset();
                    updateAuthUI();
                    navigateTo(user.role === 'officer' ? 'dasbor-petugas' : 'akun-masyarakat');
                } else {
                    alert('Email/NIP atau Kata Sandi salah!');
                }
            });

            // DAFTAR WARGA
            formRegWarga.addEventListener('submit', (e) => {
                e.preventDefault();
                const users = getStorage(STORAGE.USERS, []);
                const email = document.getElementById('regw-email').value.trim();

                if (users.find(u => u.email === email)) { alert('Email sudah terdaftar!'); return; }

                const newUser = { name: document.getElementById('regw-name').value, email: email, pass: document.getElementById('regw-pass').value, role: 'warga' };
                users.push(newUser);
                setStorage(STORAGE.USERS, users);
                setStorage(STORAGE.SESSION, newUser);

                alert('Akun Warga berhasil dibuat!');
                authModal.style.display = 'none';
                updateAuthUI();
                navigateTo('akun-masyarakat');
            });

            // DAFTAR PETUGAS & ALUR GENERATE KODE VERIFIKASI
            let pendingOfficerUser = null;
            let generatedGeneratedCode = '';

            formRegOfficer.addEventListener('submit', (e) => {
                e.preventDefault();
                const users = getStorage(STORAGE.USERS, []);
                const email = document.getElementById('rego-email').value.trim();

                if (users.find(u => u.email === email)) { alert('Email dinas petugas sudah terdaftar!'); return; }

                generatedGeneratedCode = `PETUGAS-${Math.floor(1000 + Math.random() * 9000)}`;
                pendingOfficerUser = {
                    name: document.getElementById('rego-name').value,
                    nip: document.getElementById('rego-nip').value,
                    email: email,
                    pass: document.getElementById('rego-pass').value,
                    role: 'officer',
                    verified: false
                };

                alert(`[SIMULASI EMAIL DINAS]\nKode Otentikasi Verifikasi Petugas Anda adalah: ${generatedGeneratedCode}`);
                
                formRegOfficer.style.display = 'none';
                formVerifyCode.style.display = 'block';
            });

            // VERIFIKASI KODE PETUGAS
            formVerifyCode.addEventListener('submit', (e) => {
                e.preventDefault();
                const inputCode = document.getElementById('input-verify-code').value.trim();

                if (inputCode === generatedGeneratedCode && pendingOfficerUser) {
                    pendingOfficerUser.verified = true;
                    const users = getStorage(STORAGE.USERS, []);
                    users.push(pendingOfficerUser);
                    setStorage(STORAGE.USERS, users);
                    setStorage(STORAGE.SESSION, pendingOfficerUser);

                    alert('🎉 Otentikasi Kartu & Kode Petugas Berhasil! Anda sekarang masuk sebagai Petugas Penegak.');
                    authModal.style.display = 'none';
                    updateAuthUI();
                    navigateTo('dasbor-petugas');
                } else {
                    alert('Kode verifikasi petugas tidak sesuai!');
                }
            });

            function updateAuthUI() {
                const session = getStorage(STORAGE.SESSION, null);
                const authHeaderAction = document.getElementById('auth-header-action');
                const citizenNav = document.getElementById('nav-item-citizen-dash');
                const officerNav = document.getElementById('nav-item-officer-dash');

                if (session) {
                    authHeaderAction.innerHTML = `
                        <span style="font-weight:700; font-size:0.85rem; color:var(--color-primary-dark); margin-right:0.4rem;">
                            ${session.role === 'officer' ? '🛡️ Petugas' : '👤 Warga'}: ${session.name}
                        </span>
                        <button type="button" id="btn-logout" class="btn-secondary btn-sm">Keluar</button>
                    `;
                    citizenNav.style.display = session.role === 'warga' ? 'inline-block' : 'none';
                    officerNav.style.display = session.role === 'officer' ? 'inline-block' : 'none';

                    document.getElementById('btn-logout').addEventListener('click', () => {
                        localStorage.removeItem(STORAGE.SESSION);
                        alert('Anda telah keluar akun.');
                        updateAuthUI();
                        navigateTo('beranda');
                    });
                } else {
                    authHeaderAction.innerHTML = `<button type="button" id="btn-open-auth-nav" class="btn-secondary btn-sm">Masuk / Daftar</button>`;
                    citizenNav.style.display = 'none'; officerNav.style.display = 'none';
                    document.getElementById('btn-open-auth-nav').addEventListener('click', () => { resetAuthForms(); tabLogin.classList.add('active'); formLogin.style.display = 'block'; authModal.style.display = 'flex'; });
                }
            }

            // FOTO PREVIEW
            const photoInput = document.getElementById('report-photo');
            const photoPreview = document.getElementById('photo-preview');
            photoInput.addEventListener('change', () => {
                const file = photoInput.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (e) => { photoPreview.src = e.target.result; photoPreview.style.display = 'block'; };
                    reader.readAsDataURL(file);
                }
            });

            // TERIMA LAPORAN
            document.getElementById('main-report-form').addEventListener('submit', function(e) {
                e.preventDefault();
                const session = getStorage(STORAGE.SESSION, null);

                if (!session) { alert('Silakan Masuk / Daftar Akun sebelum melapor!'); authModal.style.display = 'flex'; return; }

                const reports = getStorage(STORAGE.REPORTS, []);
                const newReport = {
                    id: `LK-${Date.now().toString().slice(-6)}`,
                    category: document.getElementById('report-category').value,
                    urgency: document.getElementById('report-urgency').value,
                    reporterName: session.name,
                    reporterEmail: session.email,
                    title: document.getElementById('report-title').value,
                    description: document.getElementById('report-description').value,
                    location: document.getElementById('location-name').value,
                    photo: photoPreview.src || '',
                    status: 'reported' // Status: reported (Belum Dibenahi), process (Dalam Proses), completed (Sudah Dibenahi)
                };

                reports.unshift(newReport);
                setStorage(STORAGE.REPORTS, reports);

                this.reset(); photoPreview.style.display = 'none';
                alert(`Laporan Pengaduan Berhasil Dikirim! Kode: ${newReport.id}`);
                navigateTo('laporan-terbaru');
            });

            // POLLING LOGIC
            document.getElementById('form-polling').addEventListener('submit', (e) => {
                e.preventDefault();
                const selected = document.querySelector('input[name="poll"]:checked').value;
                const polls = getStorage(STORAGE.POLLS, { sangat_puas: 0, cukup: 0, kurang: 0 });
                polls[selected] = (polls[selected] || 0) + 1;
                setStorage(STORAGE.POLLS, polls);
                alert('Terima kasih atas partisipasi polling Anda!');
                renderAllData();
            });

            // AKSI PETUGAS UBAH STATUS PENANGANAN
            window.updateStatusReport = function(id, newStatus) {
                const reports = getStorage(STORAGE.REPORTS, []);
                const idx = reports.findIndex(r => r.id === id);
                if (idx !== -1) {
                    reports[idx].status = newStatus;
                    setStorage(STORAGE.REPORTS, reports);
                    alert(`Status Laporan ${id} Diperbarui: ${newStatus.toUpperCase()}`);
                    renderAllData();
                }
            };

            window.deleteReport = function(id) {
                if (confirm(`Apakah Anda yakin ingin menghapus laporan ${id}?`)) {
                    let reports = getStorage(STORAGE.REPORTS, []);
                    reports = reports.filter(r => r.id !== id);
                    setStorage(STORAGE.REPORTS, reports);
                    renderAllData();
                }
            };

            // RENDER GRAFIK & DATA METRIK
            function renderAllData() {
                const reports = getStorage(STORAGE.REPORTS, []);
                const session = getStorage(STORAGE.SESSION, null);

                const total = reports.length;
                const pending = reports.filter(r => r.status === 'reported').length;
                const process = reports.filter(r => r.status === 'process').length;
                const completed = reports.filter(r => r.status === 'completed').length;

                if (document.getElementById('stat-total')) {
                    document.getElementById('stat-total').textContent = total;
                    document.getElementById('stat-reported').textContent = pending;
                    document.getElementById('stat-process').textContent = process;
                    document.getElementById('stat-completed').textContent = completed;

                    const compPct = total ? Math.round((completed / total) * 100) : 0;
                    const procPct = total ? Math.round((process / total) * 100) : 0;
                    const repPct = total ? Math.round((pending / total) * 100) : 0;

                    document.getElementById('bar-completed').style.width = `${compPct}%`;
                    document.getElementById('rate-completed-text').textContent = `${compPct}% (${completed})`;

                    document.getElementById('bar-process').style.width = `${procPct}%`;
                    document.getElementById('rate-process-text').textContent = `${procPct}% (${process})`;

                    document.getElementById('bar-reported').style.width = `${repPct}%`;
                    document.getElementById('rate-reported-text').textContent = `${repPct}% (${pending})`;
                }

                // Render Polling
                const polls = getStorage(STORAGE.POLLS, { sangat_puas: 0, cukup: 0, kurang: 0 });
                const totalVotes = polls.sangat_puas + polls.cukup + polls.kurang;
                if (document.getElementById('total-votes')) {
                    document.getElementById('total-votes').textContent = totalVotes;
                    document.getElementById('poll-res-1').textContent = polls.sangat_puas;
                    document.getElementById('poll-res-2').textContent = polls.cukup;
                    document.getElementById('poll-res-3').textContent = polls.kurang;
                }

                // CARD TEMPLATE WARGA
                const renderCard = (r) => {
                    let statusLabel = 'Belum Dibenahi';
                    if (r.status === 'process') statusLabel = 'Sedang Dikerjakan';
                    if (r.status === 'completed') statusLabel = 'Sudah Dibenahi';

                    return `
                    <article class="report-card">
                        <header style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:0.5rem;">
                            <div>
                                <small style="color:var(--color-text-muted);">ID: ${r.id} | Pelapor: ${r.reporterName}</small>
                                <h3 style="margin-top:0.2rem;">${r.title}</h3>
                            </div>
                            <div>
                                <span class="badge-urgency urgency-${r.urgency}">${r.urgency}</span>
                                <span class="status status-${r.status}">${statusLabel}</span>
                            </div>
                        </header>
                        <hr style="border:none; border-top:1px solid var(--color-border); margin:0.6rem 0;">
                        <p><strong>Kategori:</strong> ${r.category} | 📍 ${r.location}</p>
                        <p>${r.description}</p>
                        ${r.photo ? `<img src="${r.photo}" class="preview-img" style="display:block; margin-top:0.6rem;" alt="Foto Bukti">` : ''}
                    </article>`;
                };

                // CARD TEMPLATE PANELS PETUGAS TERSUSUN RAPI
                const renderOfficerCard = (r) => `
                    <article class="report-card" style="border-left: 5px solid var(--color-danger);">
                        <header style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:0.5rem;">
                            <div>
                                <small style="color:var(--color-text-muted);">ID LAPORAN: <strong>${r.id}</strong> | Kontak Pelapor: ${r.reporterName} (${r.reporterEmail})</small>
                                <h3 style="margin-top:0.2rem;">${r.title}</h3>
                            </div>
                            <div>
                                <span class="badge-urgency urgency-${r.urgency}">Urgensi: ${r.urgency}</span>
                            </div>
                        </header>
                        <hr style="border:none; border-top:1px solid var(--color-border); margin:0.6rem 0;">
                        <p><strong>Kategori Masalah:</strong> ${r.category} | 📍 <strong>Alamat Patokan:</strong> ${r.location}</p>
                        <p>${r.description}</p>
                        ${r.photo ? `<img src="${r.photo}" class="preview-img" style="display:block; margin-top:0.6rem;" alt="Bukti Foto Warga">` : ''}
                        
                        <!-- AKSINYA PETUGAS -->
                        <div style="margin-top: 1rem; padding: 0.8rem; background: var(--color-surface-soft); border-radius: var(--radius-sm); display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
                            <label style="font-size:0.8rem;"><strong>Pembaruan Fisik Penanganan:</strong></label>
                            <button type="button" onclick="updateStatusReport('${r.id}', 'reported')" class="btn-warning btn-sm">⏳ Tandai Belum Dibenahi</button>
                            <button type="button" onclick="updateStatusReport('${r.id}', 'process')" class="btn-secondary btn-sm" style="color:#0369a1;">🚧 Proses Pengerjaan</button>
                            <button type="button" onclick="updateStatusReport('${r.id}', 'completed')" class="btn-primary btn-sm">✅ Tandai Sudah Dibenahi</button>
                            <button type="button" onclick="deleteReport('${r.id}')" class="btn-danger btn-sm" style="margin-left:auto;">🗑️ Hapus Laporan</button>
                        </div>
                    </article>
                `;

                // Render Elemen HTML
                const homeList = document.getElementById('home-report-list');
                if (homeList) homeList.innerHTML = reports.length ? reports.slice(0, 3).map(renderCard).join('') : '<p>Belum ada pengaduan warga.</p>';

                const allList = document.getElementById('all-reports-list');
                if (allList) allList.innerHTML = reports.length ? reports.map(renderCard).join('') : '<p>Belum ada pengaduan warga.</p>';

                const myList = document.getElementById('my-reports-list');
                if (myList && session && session.role === 'warga') {
                    const myReports = reports.filter(r => r.reporterEmail === session.email);
                    myList.innerHTML = myReports.length ? myReports.map(renderCard).join('') : '<p>Kamu belum pernah membuat laporan.</p>';
                }

                const officerList = document.getElementById('officer-reports-list');
                if (officerList && session && session.role === 'officer') {
                    officerList.innerHTML = reports.length ? reports.map(renderOfficerCard).join('') : '<p>Tidak ada antrean laporan masuk.</p>';
                }
            }

            // NAVIGATION ROUTING
            document.addEventListener('click', (e) => {
                const link = e.target.closest('.nav-link');
                if (link) { e.preventDefault(); navigateTo(link.getAttribute('data-target')); }
            });

            // INIT APPLICATION
            updateAuthUI();
            navigateTo('beranda');
        })();
    </script>
</body>
</html>
