<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LAPORKITA - Platform Pengaduan & Dashboard Petugas</title>
    
    <style>
        :root {
            --color-primary: #16794a;
            --color-primary-dark: #0f5d39;
            --color-primary-light: #e8f5ee;

            --color-background: #f5f7f6;
            --color-surface: #ffffff;
            --color-surface-soft: #f8faf9;

            --color-text: #17221c;
            --color-text-secondary: #46534c;
            --color-text-muted: #718078;

            --color-border: #dce4df;
            --color-border-strong: #c7d2cc;

            --color-success: #16804b;
            --color-success-bg: #e7f6ed;

            --color-warning: #a56a00;
            --color-warning-bg: #fff5d9;

            --color-danger: #b43a3a;
            --color-danger-bg: #fbeaea;

            --color-white: #ffffff;

            --shadow-sm: 0 1px 3px rgba(20, 38, 29, 0.06);
            --shadow-md: 0 6px 20px rgba(20, 38, 29, 0.08);

            --radius-sm: 6px;
            --radius-md: 10px;
            --radius-lg: 16px;
            --radius-xl: 22px;

            --container-width: 1240px;
            --space-2: 0.5rem;
            --space-3: 0.75rem;
            --space-4: 1rem;
            --space-5: 1.25rem;
            --space-6: 1.5rem;
            --space-8: 2rem;
            --space-12: 3rem;
            --transition-fast: 120ms ease;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; font-size: 16px; }
        body, h1, h2, h3, h4, h5, h6, p, figure, ul, ol { margin: 0; }
        ul, ol { padding: 0; list-style: none; }
        button, input, select, textarea { font: inherit; border-radius: var(--radius-sm); }
        button { cursor: pointer; border: 1px solid transparent; }
        img { display: block; max-width: 100%; height: auto; }
        a { color: inherit; text-decoration: none; }

        body {
            min-width: 320px;
            background: var(--color-background);
            color: var(--color-text);
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;
            font-size: 1rem;
            line-height: 1.6;
        }

        main > section, main > .page {
            max-width: var(--container-width);
            margin-inline: auto;
            padding: var(--space-8) var(--space-6);
        }

        .page { animation: fadeIn 200ms ease-in-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .page-header { margin-bottom: var(--space-8); }
        .page-header p { max-width: 720px; }
        strong { font-weight: 700; }

        h1, h2, h3, h4 { color: var(--color-text); font-weight: 700; line-height: 1.2; }
        h1 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.03em; }
        h2 { font-size: clamp(1.3rem, 2vw, 1.8rem); margin-bottom: var(--space-4); }
        h3 { font-size: 1.05rem; }
        p { color: var(--color-text-secondary); }

        .platform-label {
            margin-bottom: var(--space-2);
            color: var(--color-primary);
            font-size: 0.8125rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* HEADER & NAVIGATION */
        .brand a { display: inline-flex; align-items: center; gap: var(--space-3); font-size: 1.15rem; font-weight: 800; }
        .logo-placeholder {
            display: inline-grid; width: 2.25rem; height: 2.25rem; place-items: center;
            border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm);
            background: var(--color-surface-soft); color: var(--color-primary); font-size: 0.75rem; font-weight: 800;
        }

        #site-header {
            position: sticky; top: 0; z-index: 100;
            display: flex; justify-content: space-between; align-items: center;
            min-height: 4.5rem; padding: 0 var(--space-6);
            border-bottom: 1px solid var(--color-border); background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(8px);
            box-shadow: var(--shadow-sm);
        }

        #site-header nav ul { display: flex; align-items: center; gap: var(--space-2); }
        #site-header nav a {
            display: inline-flex; align-items: center; min-height: 2.4rem; padding: 0 var(--space-4);
            border-radius: var(--radius-md); color: var(--color-text-secondary); font-size: 0.9rem; font-weight: 600;
            transition: background-color var(--transition-fast), color var(--transition-fast);
        }
        #site-header nav a:hover, #site-header nav a[aria-current="page"] {
            background: var(--color-primary-light); color: var(--color-primary-dark);
        }

        /* BUTTONS */
        .btn-primary, .btn-secondary, .btn-danger {
            display: inline-flex; align-items: center; justify-content: center;
            min-height: 2.6rem; padding: 0.5rem 1.1rem;
            border-radius: var(--radius-md); font-weight: 700; font-size: 0.9rem;
            transition: all var(--transition-fast); cursor: pointer;
        }
        .btn-primary { background: var(--color-primary); color: var(--color-white); border: 1px solid var(--color-primary); }
        .btn-primary:hover { background: var(--color-primary-dark); }
        .btn-secondary { background: var(--color-surface); color: var(--color-primary-dark); border: 1px solid var(--color-border-strong); }
        .btn-secondary:hover { background: var(--color-surface-soft); }
        .btn-danger { background: var(--color-danger); color: var(--color-white); border: 1px solid var(--color-danger); }
        .btn-sm { min-height: 2rem; padding: 0.3rem 0.75rem; font-size: 0.8rem; }

        /* HERO & CARDS */
        #beranda > .page-header {
            padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem);
            border: 1px solid var(--color-border); border-radius: var(--radius-xl);
            background: var(--color-surface); box-shadow: var(--shadow-md);
        }
        .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }

        .report-category-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: var(--space-5); }
        .report-category {
            display: flex; flex-direction: column; padding: var(--space-6);
            border: 1px solid var(--color-border); border-radius: var(--radius-lg);
            background: var(--color-surface); box-shadow: var(--shadow-sm);
        }
        .report-category ul { display: grid; gap: var(--space-2); margin: var(--space-4) 0 var(--space-6); }
        .report-category li { position: relative; padding-left: 1rem; color: var(--color-text-secondary); font-size: 0.875rem; }
        .report-category li::before { content: "•"; position: absolute; left: 0; color: var(--color-primary); }

        /* STATS & PROGRESS BARS */
        .statistics-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-4); }
        .statistics-summary article { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
        .statistics-summary data { display: block; margin-top: var(--space-2); font-size: 1.8rem; font-weight: 800; color: var(--color-primary); }

        .stat-card-box { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); margin-bottom: 1.5rem; }
        .progress-bar-bg { width: 100%; height: 12px; background: var(--color-border); border-radius: 999px; overflow: hidden; margin: 0.5rem 0 1.2rem; }
        .progress-bar-fill { height: 100%; background: var(--color-primary); width: 0%; transition: width 0.4s ease; }

        /* FORMS & INPUTS */
        fieldset { margin-bottom: var(--space-6); padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
        legend { padding-inline: var(--space-2); font-weight: 700; color: var(--color-primary-dark); }
        
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); }
        .form-field { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: var(--space-4); }
        label { font-weight: 600; font-size: 0.875rem; color: var(--color-text); }
        input, select, textarea {
            width: 100%; border: 1px solid var(--color-border-strong); background: var(--color-surface);
            color: var(--color-text); padding: 0.65rem 0.8rem; border-radius: var(--radius-sm); outline: none;
        }
        textarea { min-height: 7rem; resize: vertical; }
        input:focus, select:focus, textarea:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px var(--color-primary-light); }

        .radio-group, .checkbox-group { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 0.2rem; }
        .radio-label, .checkbox-label { display: flex; align-items: center; gap: 0.4rem; font-size: 0.875rem; cursor: pointer; background: var(--color-surface-soft); padding: 0.4rem 0.8rem; border-radius: var(--radius-sm); border: 1px solid var(--color-border); }
        .radio-label input, .checkbox-label input { width: auto; margin: 0; accent-color: var(--color-primary); }

        /* LIST & BADGES */
        .latest-report-list { display: grid; gap: var(--space-4); }
        .report-card { padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-sm); }
        .status { display: inline-flex; padding: 0.2rem 0.65rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
        .status-reported { background: var(--color-warning-bg); color: var(--color-warning); }
        .status-process { background: #e0f2fe; color: #0369a1; }
        .status-completed { background: var(--color-success-bg); color: var(--color-success); }
        
        .badge-urgency { padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; }
        .urgency-Biasa { background: #e2e8f0; color: #334155; }
        .urgency-Penting { background: #fef08a; color: #854d0e; }
        .urgency-Darurat { background: var(--color-danger-bg); color: var(--color-danger); }
        .preview-img { max-height: 140px; border-radius: var(--radius-md); margin-top: 0.5rem; display: none; border: 1px solid var(--color-border); }

        /* MODAL AUTH */
        .modal { position: fixed; inset: 0; z-index: 1000; display: none; align-items: center; justify-content: center; background: rgba(17, 23, 19, 0.6); backdrop-filter: blur(4px); padding: 1rem; }
        .modal-content { position: relative; background: var(--color-surface); padding: var(--space-6); border-radius: var(--radius-lg); max-width: 440px; width: 100%; box-shadow: var(--shadow-md); }
        .auth-tabs { display: flex; border-bottom: 2px solid var(--color-border); margin-bottom: var(--space-5); }
        .auth-tab-btn { flex: 1; padding: var(--space-3); border: none; background: none; font-weight: 700; color: var(--color-text-muted); cursor: pointer; }
        .auth-tab-btn.active { border-bottom: 3px solid var(--color-primary); color: var(--color-primary); }

        footer.site-footer { text-align: center; padding: var(--space-8) var(--space-6); border-top: 1px solid var(--color-border); margin-top: var(--space-12); background: var(--color-surface); color: var(--color-text-muted); font-size: 0.875rem; }
    </style>
</head>

<body>

    <!-- GLOBAL HEADER -->
    <header id="site-header">
        <div class="brand">
            <a href="#beranda" class="nav-link" data-target="beranda">
                <span class="logo-placeholder">LK</span>
                <span>LAPORKITA</span>
            </a>
        </div>

        <nav aria-label="Navigasi utama">
            <ul>
                <li><a href="#beranda" class="nav-link" data-target="beranda">Beranda</a></li>
                <li><a href="#halaman-statistik" class="nav-link" data-target="halaman-statistik">Statistik Analitis</a></li>
                <li><a href="#peta-laporan" class="nav-link" data-target="peta-laporan">Peta Wilayah</a></li>
                <li><a href="#laporan-terbaru" class="nav-link" data-target="laporan-terbaru">Laporan Warga</a></li>
                <li><a href="#formulir-laporan" class="nav-link" data-target="formulir-laporan">Buat Laporan</a></li>
                <li id="nav-item-citizen-dash" style="display: none;"><a href="#akun-masyarakat" class="nav-link" data-target="akun-masyarakat">Laporan Saya</a></li>
                <li id="nav-item-officer-dash" style="display: none;"><a href="#dasbor-petugas" class="nav-link" data-target="dasbor-petugas" style="color:var(--color-danger); border:1px solid var(--color-border);">🛡️ Panel Petugas</a></li>
            </ul>
        </nav>

        <div id="auth-header-action">
            <button type="button" id="btn-open-auth" class="btn-secondary btn-sm">Masuk / Daftar Akun</button>
        </div>
    </header>

    <!-- MAIN APPLICATION -->
    <main id="main-content">

        <!-- 01. BERANDA -->
        <section id="beranda" class="page">
            <header class="page-header">
                <p class="platform-label">Platform Partisipasi Publik</p>
                <h1>Laporkan & Pantau Masalah di Sekitarmu</h1>
                <p>LAPORKITA mempermudah warga untuk melaporkan fasilitas publik yang rusak, kebersihan lingkungan, hingga dugaan pungli secara transparan dan terintegrasi.</p>

                <div class="hero-actions">
                    <a href="#formulir-laporan" class="nav-link btn-primary" data-target="formulir-laporan">📝 Buat Laporan Sekarang</a>
                    <a href="#halaman-statistik" class="nav-link btn-secondary" data-target="halaman-statistik">📊 Lihat Statistik Wilayah</a>
                </div>
            </header>

            <section id="kategori-laporan" style="margin-top: 2rem;">
                <h2>Pilih Kategori Masalah</h2>
                <div class="report-category-list">
                    <article class="report-category">
                        <h3>Fasilitas Publik</h3>
                        <ul>
                            <li>Jalan / Trotoar Rusak</li>
                            <li>Lampu Jalan Mati</li>
                            <li>Drainase Tersumbat</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-secondary btn-category-select" data-category="Fasilitas Publik" data-target="formulir-laporan">Lapor Fasilitas</a>
                    </article>

                    <article class="report-category">
                        <h3>Ketertiban & Pungli</h3>
                        <ul>
                            <li>Pungutan Tanpa Izin</li>
                            <li>Biaya di Luar Ketentuan</li>
                            <li>Gangguan Ketertiban</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-secondary btn-category-select" data-category="Ketertiban & Pungli" data-target="formulir-laporan">Lapor Pungli / Ketertiban</a>
                    </article>

                    <article class="report-category">
                        <h3>Kebersihan & Lingkungan</h3>
                        <ul>
                            <li>Penumpukan Sampah</li>
                            <li>Pencemaran Limbah</li>
                            <li>Potensi Banjir</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-secondary btn-category-select" data-category="Kebersihan & Lingkungan" data-target="formulir-laporan">Lapor Lingkungan</a>
                    </article>

                    <article class="report-category">
                        <h3>Pelayanan Publik</h3>
                        <ul>
                            <li>Layanan Desa / Kelurahan</li>
                            <li>Administrasi Lambat</li>
                            <li>Keluhan Pelayanan</li>
                        </ul>
                        <a href="#formulir-laporan" class="nav-link btn-secondary btn-category-select" data-category="Pelayanan Publik" data-target="formulir-laporan">Lapor Pelayanan</a>
                    </article>
                </div>
            </section>

            <section style="margin-top: 3rem;">
                <h2>Laporan Warga Terbaru</h2>
                <div class="latest-report-list" id="home-report-list"></div>
            </section>
        </section>

        <!-- 02. HALAMAN DEDICATED STATISTIK WILAYAH -->
        <section id="halaman-statistik" class="page" style="display: none;">
            <header class="page-header">
                <h1>Statistik & Transparansi Wilayah</h1>
                <p>Data real-time penanganan pengaduan masyarakat oleh instansi penegak dan pelayanan publik.</p>
            </header>

            <div class="statistics-summary" style="margin-bottom: 2rem;">
                <article><h3>Total Masuk</h3><data id="stat-total">0</data></article>
                <article><h3>Dalam Verifikasi</h3><data id="stat-reported">0</data></article>
                <article><h3>Proses Tindak Lanjut</h3><data id="stat-process">0</data></article>
                <article><h3>Laporan Selesai</h3><data id="stat-completed">0</data></article>
                <article><h3>Persentase Selesai</h3><data id="stat-rate">0%</data></article>
            </div>

            <div class="form-grid">
                <!-- METRIK KATEGORI -->
                <div class="stat-card-box">
                    <h3>Sebaran Berdasarkan Kategori</h3>
                    <p><small>Persentase pengaduan warga per jenis masalah</small></p>
                    <div style="margin-top: 1rem;">
                        <div><strong>Fasilitas Publik</strong> (<span id="count-cat-fasilitas">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-fasilitas" class="progress-bar-fill"></div></div>

                        <div><strong>Ketertiban & Pungli</strong> (<span id="count-cat-pungli">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-pungli" class="progress-bar-fill" style="background: var(--color-warning);"></div></div>

                        <div><strong>Kebersihan & Lingkungan</strong> (<span id="count-cat-lingkungan">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-lingkungan" class="progress-bar-fill" style="background: #0284c7;"></div></div>

                        <div><strong>Pelayanan Publik</strong> (<span id="count-cat-pelayanan">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-cat-pelayanan" class="progress-bar-fill" style="background: #9333ea;"></div></div>
                    </div>
                </div>

                <!-- METRIK URGENSI -->
                <div class="stat-card-box">
                    <h3>Tingkat Urgensi Masalah</h3>
                    <p><small>Klasifikasi bobot kedaruratan laporan</small></p>
                    <div style="margin-top: 1rem;">
                        <div>🟢 <strong>Biasa</strong> (<span id="count-urg-biasa">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-urg-biasa" class="progress-bar-fill" style="background: #64748b;"></div></div>

                        <div>🟡 <strong>Penting</strong> (<span id="count-urg-penting">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-urg-penting" class="progress-bar-fill" style="background: var(--color-warning);"></div></div>

                        <div>🔴 <strong>Darurat (Bahaya)</strong> (<span id="count-urg-darurat">0</span>)</div>
                        <div class="progress-bar-bg"><div id="bar-urg-darurat" class="progress-bar-fill" style="background: var(--color-danger);"></div></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03. PETA WILAYAH LAPORAN -->
        <section id="peta-laporan" class="page" style="display: none;">
            <header class="page-header">
                <h1>Peta Sebaran Laporan Wilayah</h1>
                <p>Visualisasi spasial lokasi permasalahan fasilitas dan lingkungan yang dilaporkan warga.</p>
            </header>
            <div style="min-height: 320px; border: 2px dashed var(--color-border-strong); border-radius: var(--radius-lg); display: grid; place-items: center; background: var(--color-surface);">
                <div style="text-align: center;">
                    <p style="font-size: 1.2rem; font-weight: 700;">🗺️ Container Peta (Siap Integrasi LeafletJS / Google Maps)</p>
                    <small>Titik GPS otomatis tersinkronisasi saat warga mengirimkan laporan dengan koordinat.</small>
                </div>
            </div>
        </section>

        <!-- 04. LAPORAN TERBARU WARGA -->
        <section id="laporan-terbaru" class="page" style="display: none;">
            <header class="page-header">
                <h1>Kumpulan Laporan Warga</h1>
                <p>Daftar transparan seluruh pengaduan yang dikirimkan oleh masyarakat secara publik.</p>
            </header>
            <div class="latest-report-list" id="all-reports-list"></div>
        </section>

        <!-- 05. FORMULIR LAPORAN SUPER LENGKAP -->
        <section id="formulir-laporan" class="page" style="display: none;">
            <header class="page-header">
                <h1>Buat Laporan Pengaduan</h1>
                <p>Isi formulir berikut dengan lengkap untuk mempercepat verifikasi dan tindak lanjut petugas.</p>
            </header>

            <form id="main-report-form">
                <fieldset>
                    <legend>1. Klasifikasi Masalah & Urgensi</legend>
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="report-category">Kategori Utama *</label>
                            <select id="report-category" required>
                                <option value="">-- Pilih Kategori --</option>
                                <option value="Fasilitas Publik">Fasilitas Publik</option>
                                <option value="Ketertiban & Pungli">Ketertiban & Pungli</option>
                                <option value="Kebersihan & Lingkungan">Kebersihan & Lingkungan</option>
                                <option value="Pelayanan Publik">Pelayanan Publik</option>
                            </select>
                        </div>
                        <div class="form-field">
                            <label for="report-subcategory">Sub-Kategori Spesifik</label>
                            <input type="text" id="report-subcategory" placeholder="Contoh: Lampu Jalan / Sampah Liar">
                        </div>
                    </div>

                    <div class="form-field">
                        <label>Tingkat Urgensi Masalah *</label>
                        <div class="radio-group">
                            <label class="radio-label"><input type="radio" name="urgency" value="Biasa" checked> 🟢 Biasa</label>
                            <label class="radio-label"><input type="radio" name="urgency" value="Penting"> 🟡 Penting</label>
                            <label class="radio-label"><input type="radio" name="urgency" value="Darurat"> 🔴 Darurat (Bahaya)</label>
                        </div>
                    </div>
                </fieldset>

                <fieldset>
                    <legend>2. Detail Masalah & Lokasi Kejadian</legend>
                    <div class="form-field">
                        <label for="report-title">Judul Laporan *</label>
                        <input type="text" id="report-title" required placeholder="Tuliskan ringkasan masalah singkat">
                    </div>

                    <div class="form-field">
                        <label for="report-description">Deskripsi Kronologi Kejadian *</label>
                        <textarea id="report-description" required placeholder="Jelaskan detail waktu, kronologi, dan dampak permasalahan..."></textarea>
                    </div>

                    <div class="form-grid">
                        <div class="form-field">
                            <label for="incident-date">Tanggal & Waktu Kejadian</label>
                            <input type="datetime-local" id="incident-date">
                        </div>
                        <div class="form-field">
                            <label>Koordinat Presisi GPS</label>
                            <div style="display: flex; gap: 0.5rem;">
                                <input type="text" id="report-gps" placeholder="-6.1234, 106.5678" readonly style="background: var(--color-surface-soft);">
                                <button type="button" id="btn-get-gps" class="btn-secondary btn-sm">📍 Deteksi GPS</button>
                            </div>
                        </div>
                    </div>

                    <div class="form-field">
                        <label for="location-name">Alamat Patokan Detail *</label>
                        <input type="text" id="location-name" required placeholder="Contoh: RT 02/RW 04 Depan Balai Desa Sukamaju">
                    </div>
                </fieldset>

                <fieldset>
                    <legend>3. Bukti Visual & Opsi Identitas</legend>
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="report-photo">Foto Bukti Lapangan *</label>
                            <input type="file" id="report-photo" accept="image/*" required>
                            <img id="photo-preview" class="preview-img" alt="Preview Foto Bukti">
                        </div>
                        <div class="form-field">
                            <label for="report-attachment">File Lampiran Dokumen (Opsional)</label>
                            <input type="file" id="report-attachment">
                        </div>
                    </div>

                    <div class="form-field" style="margin-top: 1rem;">
                        <label>Kerahasiaan Nama Pelapor</label>
                        <div class="checkbox-group">
                            <label class="checkbox-label"><input type="checkbox" id="is-anonymous"> 🔒 Sembunyikan Nama Saya (Kirim sebagai Warga Anonim)</label>
                        </div>
                    </div>

                    <div class="form-field" style="margin-top: 0.5rem;">
                        <div class="checkbox-group">
                            <label class="checkbox-label"><input type="checkbox" id="agree-terms" required> ⚖️ Saya menyatakan bahwa data laporan ini valid dan dapat dipertanggungjawabkan.</label>
                        </div>
                    </div>
                </fieldset>

                <div style="display: flex; gap: 1rem;">
                    <button type="submit" class="btn-primary" style="flex:1;">🚀 Kirim Laporan Pengaduan</button>
                    <button type="reset" class="btn-secondary">Reset Form</button>
                </div>
            </form>
        </section>

        <!-- 06. DASBOR WARGA -->
        <section id="akun-masyarakat" class="page" style="display: none;">
            <header class="page-header">
                <h1>Dashboard Pengaduan Saya</h1>
                <p id="user-welcome-text">Riwayat laporan yang telah kamu kirimkan ke sistem.</p>
            </header>
            <div id="my-reports-list" class="latest-report-list"></div>
        </section>

        <!-- 07. DASBOR PENEGAK HUKUM / PETUGAS (BARU!) -->
        <section id="dasbor-petugas" class="page" style="display: none;">
            <header class="page-header">
                <p class="platform-label" style="color:var(--color-danger);">Akses Petugas & Otentikasi Terverifikasi</p>
                <h1>Panel Kontrol Penegak & Petugas Wilayah</h1>
                <p>Kelola, tindak lanjuti, dan perbarui status laporan pengaduan masuk dari masyarakat.</p>
            </header>

            <div id="officer-reports-list" class="latest-report-list"></div>
        </section>

    </main>

    <!-- MODAL AUTHENTICATION (LOGIN & REGISTER) -->
    <div id="auth-modal" class="modal">
        <div class="modal-content">
            <div class="auth-tabs">
                <button type="button" class="auth-tab-btn active" id="tab-btn-login">Masuk (Login)</button>
                <button type="button" class="auth-tab-btn" id="tab-btn-register">Daftar Akun (Register)</button>
            </div>

            <!-- FORM LOGIN -->
            <form id="form-login">
                <h2>Masuk ke LAPORKITA</h2>
                <p style="font-size:0.8rem; color:var(--color-text-muted); margin-bottom:1rem;">Gunakan <strong>petugas / password123</strong> untuk masuk sebagai Petugas.</p>
                <div class="form-field">
                    <label for="login-email">Email / Username</label>
                    <input type="text" id="login-email" required placeholder="email@domain.com atau username">
                </div>
                <div class="form-field">
                    <label for="login-password">Kata Sandi</label>
                    <input type="password" id="login-password" required placeholder="Password akun kamu">
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem;">Masuk Akun</button>
            </form>

            <!-- FORM REGISTER -->
            <form id="form-register" style="display: none;">
                <h2>Buat Akun Baru</h2>
                <div class="form-field" style="margin-top: 1rem;">
                    <label for="reg-fullname">Nama Lengkap *</label>
                    <input type="text" id="reg-fullname" required placeholder="Sesuai KTP">
                </div>
                <div class="form-field">
                    <label for="reg-username">Username *</label>
                    <input type="text" id="reg-username" required placeholder="Contoh: ahmad_lapor">
                </div>
                <div class="form-field">
                    <label for="reg-email">Alamat Email *</label>
                    <input type="email" id="reg-email" required placeholder="nama@email.com">
                </div>
                <div class="form-grid">
                    <div class="form-field">
                        <label for="reg-password">Password *</label>
                        <input type="password" id="reg-password" minlength="6" required placeholder="Min 6 Karakter">
                    </div>
                    <div class="form-field">
                        <label for="reg-confirm">Konfirmasi *</label>
                        <input type="password" id="reg-confirm" minlength="6" required placeholder="Ulangi Pass">
                    </div>
                </div>
                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 1rem;">Daftar Akun LAPORKITA</button>
            </form>

            <button type="button" id="btn-close-modal" class="btn-secondary btn-sm" style="width: 100%; margin-top: 1rem;">Batal</button>
        </div>
    </div>

    <!-- GLOBAL FOOTER -->
    <footer class="site-footer">
        <p>&copy; 2026 LAPORKITA - Platform Pengaduan & Aspirasi Warga Berbasis Civic-Tech.</p>
    </footer>

    <!-- SCRIPT APPLICATION -->
    <script>
        (() => {
            'use strict';
            const STORAGE = { USERS: 'laporkita_users', SESSION: 'laporkita_session', REPORTS: 'laporkita_reports' };

            function getStorage(key, fallback = []) {
                try { const item = localStorage.getItem(key); return item ? JSON.parse(item) : fallback; } catch(e) { return fallback; }
            }
            function setStorage(key, val) {
                try { localStorage.setItem(key, JSON.stringify(val)); } catch(e) {}
            }

            // User bawaan: Warga Arga & Petugas Penegak
            if (!localStorage.getItem(STORAGE.USERS)) {
                setStorage(STORAGE.USERS, [
                    { fullname: 'Mohammad Arga', username: 'arga', email: 'arga@test.com', password: 'password123', role: 'warga' },
                    { fullname: 'Bripka Susanto (Satgas)', username: 'petugas', email: 'petugas@polri.go.id', password: 'password123', role: 'officer' }
                ]);
            }

            function navigateTo(targetId) {
                document.querySelectorAll('.page').forEach(p => p.style.display = 'none');
                const targetPage = document.getElementById(targetId) || document.getElementById('beranda');
                targetPage.style.display = 'block';

                document.querySelectorAll('#site-header nav a').forEach(a => {
                    if (a.getAttribute('data-target') === targetId) a.setAttribute('aria-current', 'page');
                    else a.removeAttribute('aria-current');
                });

                window.scrollTo(0, 0);
                renderAllData();
            }

            // MODAL & AUTH CONTROL
            const authModal = document.getElementById('auth-modal');
            const tabLoginBtn = document.getElementById('tab-btn-login');
            const tabRegBtn = document.getElementById('tab-btn-register');
            const formLogin = document.getElementById('form-login');
            const formRegister = document.getElementById('form-register');

            tabLoginBtn.addEventListener('click', () => {
                tabLoginBtn.classList.add('active'); tabRegBtn.classList.remove('active');
                formLogin.style.display = 'block'; formRegister.style.display = 'none';
            });

            tabRegBtn.addEventListener('click', () => {
                tabRegBtn.classList.add('active'); tabLoginBtn.classList.remove('active');
                formRegister.style.display = 'block'; formLogin.style.display = 'none';
            });

            document.getElementById('btn-close-modal').addEventListener('click', () => authModal.style.display = 'none');

            // REGISTER
            formRegister.addEventListener('submit', (e) => {
                e.preventDefault();
                const pass = document.getElementById('reg-password').value;
                const confirmPass = document.getElementById('reg-confirm').value;

                if (pass !== confirmPass) { alert('Konfirmasi kata sandi tidak cocok!'); return; }

                const users = getStorage(STORAGE.USERS, []);
                const email = document.getElementById('reg-email').value.trim();
                const username = document.getElementById('reg-username').value.trim();

                if (users.find(u => u.email === email || u.username === username)) {
                    alert('Email atau Username ini sudah terdaftar!');
                    return;
                }

                const newUser = {
                    fullname: document.getElementById('reg-fullname').value,
                    username: username,
                    email: email,
                    password: pass,
                    role: 'warga'
                };

                users.push(newUser);
                setStorage(STORAGE.USERS, users);
                setStorage(STORAGE.SESSION, newUser);

                alert('Pendaftaran akun baru berhasil! Anda otomatis masuk.');
                authModal.style.display = 'none';
                formRegister.reset();
                updateAuthUI();
                navigateTo('akun-masyarakat');
            });

            // LOGIN
            formLogin.addEventListener('submit', (e) => {
                e.preventDefault();
                const inputId = document.getElementById('login-email').value.trim();
                const pass = document.getElementById('login-password').value;
                const users = getStorage(STORAGE.USERS, []);

                const user = users.find(u => (u.email === inputId || u.username === inputId) && u.password === pass);
                if (user) {
                    setStorage(STORAGE.SESSION, user);
                    alert(`Selamat datang kembali, ${user.fullname}!`);
                    authModal.style.display = 'none';
                    formLogin.reset();
                    updateAuthUI();
                    navigateTo(user.role === 'officer' ? 'dasbor-petugas' : 'akun-masyarakat');
                } else {
                    alert('Email/Username atau Kata Sandi salah!');
                }
            });

            function updateAuthUI() {
                const session = getStorage(STORAGE.SESSION, null);
                const authHeaderAction = document.getElementById('auth-header-action');
                const citizenNav = document.getElementById('nav-item-citizen-dash');
                const officerNav = document.getElementById('nav-item-officer-dash');

                if (session) {
                    authHeaderAction.innerHTML = `
                        <span style="font-weight:700; font-size:0.85rem; color:var(--color-primary-dark); margin-right:0.4rem;">👤 ${session.fullname} (${session.role === 'officer' ? 'Petugas' : 'Warga'})</span>
                        <button type="button" id="btn-logout" class="btn-secondary btn-sm">Keluar</button>
                    `;
                    citizenNav.style.display = session.role === 'warga' ? 'inline-block' : 'none';
                    officerNav.style.display = session.role === 'officer' ? 'inline-block' : 'none';

                    document.getElementById('btn-logout').addEventListener('click', () => {
                        localStorage.removeItem(STORAGE.SESSION);
                        alert('Anda telah keluar akun.');
                        updateAuthUI();
                        navigateTo('beranda');
                    });
                } else {
                    authHeaderAction.innerHTML = `
                        <button type="button" id="btn-open-auth-nav" class="btn-secondary btn-sm">Masuk / Daftar Akun</button>
                    `;
                    citizenNav.style.display = 'none';
                    officerNav.style.display = 'none';
                    document.getElementById('btn-open-auth-nav').addEventListener('click', () => authModal.style.display = 'flex');
                }
            }

            // GPS & FOTO PREVIEW
            document.getElementById('btn-get-gps').addEventListener('click', () => {
                const inputGps = document.getElementById('report-gps');
                inputGps.value = "Mendeteksi...";
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                        (p) => inputGps.value = `${p.coords.latitude.toFixed(5)}, ${p.coords.longitude.toFixed(5)}`,
                        () => inputGps.value = "-6.91746, 107.61912 (GPS Default)"
                    );
                } else inputGps.value = "-6.91746, 107.61912 (GPS Default)";
            });

            const photoInput = document.getElementById('report-photo');
            const photoPreview = document.getElementById('photo-preview');
            photoInput.addEventListener('change', () => {
                const file = photoInput.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = (e) => { photoPreview.src = e.target.result; photoPreview.style.display = 'block'; };
                    reader.readAsDataURL(file);
                }
            });

            // TERIMA LAPORAN
            document.getElementById('main-report-form').addEventListener('submit', function(e) {
                e.preventDefault();
                const session = getStorage(STORAGE.SESSION, null);

                if (!session) {
                    alert('Anda harus Masuk / Membuat Akun terlebih dahulu sebelum mengirimkan laporan!');
                    authModal.style.display = 'flex';
                    return;
                }

                const reports = getStorage(STORAGE.REPORTS, []);
                const isAnon = document.getElementById('is-anonymous').checked;
                const urgencyVal = document.querySelector('input[name="urgency"]:checked').value;

                const newReport = {
                    id: `LK-${Date.now().toString().slice(-6)}`,
                    category: document.getElementById('report-category').value,
                    subcategory: document.getElementById('report-subcategory').value || '-',
                    urgency: urgencyVal,
                    isAnonymous: isAnon,
                    reporterName: isAnon ? 'Warga Anonim' : session.fullname,
                    reporterEmail: session.email,
                    title: document.getElementById('report-title').value,
                    description: document.getElementById('report-description').value,
                    incidentDate: document.getElementById('incident-date').value || new Date().toLocaleString(),
                    gps: document.getElementById('report-gps').value || 'Tidak Ada Koordinat',
                    location: document.getElementById('location-name').value,
                    photo: photoPreview.src || '',
                    status: 'reported' // Status: reported, process, completed
                };

                reports.unshift(newReport);
                setStorage(STORAGE.REPORTS, reports);

                this.reset();
                photoPreview.style.display = 'none';
                alert(`Laporan Pengaduan Terkirim! Kode ID: ${newReport.id}`);
                navigateTo('laporan-terbaru');
            });

            // PENEGAK / PETUGAS: UBAH STATUS LAPORAN
            window.updateStatusReport = function(id, newStatus) {
                const reports = getStorage(STORAGE.REPORTS, []);
                const idx = reports.findIndex(r => r.id === id);
                if (idx !== -1) {
                    reports[idx].status = newStatus;
                    setStorage(STORAGE.REPORTS, reports);
                    alert(`Status laporan ${id} berhasil diperbarui menjadi ${newStatus.toUpperCase()}`);
                    renderAllData();
                }
            };

            window.deleteReport = function(id) {
                if (confirm(`Apakah Anda yakin ingin menghapus laporan ${id}?`)) {
                    let reports = getStorage(STORAGE.REPORTS, []);
                    reports = reports.filter(r => r.id !== id);
                    setStorage(STORAGE.REPORTS, reports);
                    renderAllData();
                }
            };

            // RENDER DATA METRIK & KARTU
            function renderAllData() {
                const reports = getStorage(STORAGE.REPORTS, []);
                const session = getStorage(STORAGE.SESSION, null);

                // 1. STATISTIK ANGKA
                const total = reports.length;
                const pending = reports.filter(r => r.status === 'reported').length;
                const process = reports.filter(r => r.status === 'process').length;
                const completed = reports.filter(r => r.status === 'completed').length;
                const rate = total ? `${Math.round((completed / total) * 100)}%` : '0%';

                if (document.getElementById('stat-total')) {
                    document.getElementById('stat-total').textContent = total;
                    document.getElementById('stat-reported').textContent = pending;
                    document.getElementById('stat-process').textContent = process;
                    document.getElementById('stat-completed').textContent = completed;
                    document.getElementById('stat-rate').textContent = rate;
                }

                // 2. BREAKDOWN STATISTIK KATEGORI & URGENSI
                if (document.getElementById('halaman-statistik')) {
                    const countCat = (cat) => reports.filter(r => r.category === cat).length;
                    const catFas = countCat('Fasilitas Publik');
                    const catPungli = countCat('Ketertiban & Pungli');
                    const catLing = countCat('Kebersihan & Lingkungan');
                    const catPel = countCat('Pelayanan Publik');

                    document.getElementById('count-cat-fasilitas').textContent = catFas;
                    document.getElementById('count-cat-pungli').textContent = catPungli;
                    document.getElementById('count-cat-lingkungan').textContent = catLing;
                    document.getElementById('count-cat-pelayanan').textContent = catPel;

                    document.getElementById('bar-cat-fasilitas').style.width = total ? `${(catFas/total)*100}%` : '0%';
                    document.getElementById('bar-cat-pungli').style.width = total ? `${(catPungli/total)*100}%` : '0%';
                    document.getElementById('bar-cat-lingkungan').style.width = total ? `${(catLing/total)*100}%` : '0%';
                    document.getElementById('bar-cat-pelayanan').style.width = total ? `${(catPel/total)*100}%` : '0%';

                    const countUrg = (u) => reports.filter(r => r.urgency === u).length;
                    const urgB = countUrg('Biasa');
                    const urgP = countUrg('Penting');
                    const urgD = countUrg('Darurat');

                    document.getElementById('count-urg-biasa').textContent = urgB;
                    document.getElementById('count-urg-penting').textContent = urgP;
                    document.getElementById('count-urg-darurat').textContent = urgD;

                    document.getElementById('bar-urg-biasa').style.width = total ? `${(urgB/total)*100}%` : '0%';
                    document.getElementById('bar-urg-penting').style.width = total ? `${(urgP/total)*100}%` : '0%';
                    document.getElementById('bar-urg-darurat').style.width = total ? `${(urgD/total)*100}%` : '0%';
                }

                // TEMPLATE LAPORAN UMUM
                const renderCard = (r) => {
                    let statusLabel = 'VERIFIKASI';
                    if (r.status === 'process') statusLabel = 'PROSES';
                    if (r.status === 'completed') statusLabel = 'SELESAI';

                    return `
                    <article class="report-card">
                        <header style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:0.5rem;">
                            <div>
                                <small style="color:var(--color-text-muted);">ID: ${r.id} | Oleh: ${r.reporterName}</small>
                                <h3 style="margin-top:0.2rem;">${r.title}</h3>
                            </div>
                            <div>
                                <span class="badge-urgency urgency-${r.urgency}">${r.urgency}</span>
                                <span class="status status-${r.status}">${statusLabel}</span>
                            </div>
                        </header>
                        <hr style="border:none; border-top:1px solid var(--color-border); margin:0.6rem 0;">
                        <p><strong>Kategori:</strong> ${r.category} (${r.subcategory})</p>
                        <p>${r.description}</p>
                        <p><small>📍 Lokasi: ${r.location} | GPS: ${r.gps}</small></p>
                        ${r.photo ? `<img src="${r.photo}" class="preview-img" style="display:block; margin-top:0.6rem;" alt="Foto Bukti">` : ''}
                    </article>`;
                };

                // TEMPLATE LAPORAN UNTUK PENEGAK / PETUGAS (DENGAN AKSbrowser KONTROL)
                const renderOfficerCard = (r) => `
                    <article class="report-card" style="border-left: 4px solid var(--color-primary);">
                        <header style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:0.5rem;">
                            <div>
                                <small style="color:var(--color-text-muted);">ID: ${r.id} | Pelapor: ${r.reporterName} (${r.reporterEmail})</small>
                                <h3 style="margin-top:0.2rem;">${r.title}</h3>
                            </div>
                            <div>
                                <span class="badge-urgency urgency-${r.urgency}">${r.urgency}</span>
                            </div>
                        </header>
                        <hr style="border:none; border-top:1px solid var(--color-border); margin:0.6rem 0;">
                        <p><strong>Kategori:</strong> ${r.category} | 📍 ${r.location} (${r.gps})</p>
                        <p>${r.description}</p>
                        ${r.photo ? `<img src="${r.photo}" class="preview-img" style="display:block; margin-top:0.6rem;" alt="Foto Bukti">` : ''}
                        
                        <!-- AKSINYA PETUGAS -->
                        <div style="margin-top: 1rem; padding: 0.8rem; background: var(--color-surface-soft); border-radius: var(--radius-sm); display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
                            <label style="font-size:0.8rem;"><strong>Ubah Status Petugas:</strong></label>
                            <button type="button" onclick="updateStatusReport('${r.id}', 'reported')" class="btn-secondary btn-sm">Verifikasi</button>
                            <button type="button" onclick="updateStatusReport('${r.id}', 'process')" class="btn-secondary btn-sm" style="color:#0369a1;">Proses Tindak Lanjut</button>
                            <button type="button" onclick="updateStatusReport('${r.id}', 'completed')" class="btn-primary btn-sm">Selesaikan Laporan</button>
                            <button type="button" onclick="deleteReport('${r.id}')" class="btn-danger btn-sm" style="margin-left:auto;">Hapus</button>
                        </div>
                    </article>
                `;

                // Render List
                const homeList = document.getElementById('home-report-list');
                if (homeList) homeList.innerHTML = reports.length ? reports.slice(0, 3).map(renderCard).join('') : '<p>Belum ada laporan yang masuk.</p>';

                const allList = document.getElementById('all-reports-list');
                if (allList) allList.innerHTML = reports.length ? reports.map(renderCard).join('') : '<p>Belum ada laporan warga.</p>';

                const myList = document.getElementById('my-reports-list');
                if (myList && session && session.role === 'warga') {
                    const myReports = reports.filter(r => r.reporterEmail === session.email);
                    myList.innerHTML = myReports.length ? myReports.map(renderCard).join('') : '<p>Kamu belum memiliki riwayat pengaduan.</p>';
                }

                const officerList = document.getElementById('officer-reports-list');
                if (officerList && session && session.role === 'officer') {
                    officerList.innerHTML = reports.length ? reports.map(renderOfficerCard).join('') : '<p>Tidak ada pengaduan masuk di sistem.</p>';
                }
            }

            // ROUTER EVENT
            document.addEventListener('click', (e) => {
                const link = e.target.closest('.nav-link');
                if (link) {
                    e.preventDefault();
                    const target = link.getAttribute('data-target');

                    if (link.classList.contains('btn-category-select')) {
                        const cat = link.getAttribute('data-category');
                        const selectEl = document.getElementById('report-category');
                        if (selectEl && cat) selectEl.value = cat;
                    }

                    navigateTo(target);
                }
            });

            // INIT
            updateAuthUI();
            navigateTo('beranda');
        })();
    </script>
</body>
</html>
