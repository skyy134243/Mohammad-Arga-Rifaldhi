:root {
  font-family: Manrope, Arial, sans-serif;
   color: #252c32
  background: #11100f
  font-synthesis: none;
}

html {
  scorll-behavoir: smooth;
}

body {
  min-width:320px;
  min-heigth:100vh;
  margin: 0;
  background:#1100f
}

button, input{
  font: inherit;
}

button {
  border:0;
  cursor: pointers;
}

.page {
  box-sizing: border.box;
  position: relative;
  display: grid;
  main heigth:100hv;
  place-items: center;
  overflow: hidden;
  padding: 56px 20px;
}

.glow {
  position: fixed;
  top: -220px;
  left: 50%;
  width: 620px;
  heigth: 620px;
  transform: translateX(-50%);
  pointer-events: none;
  background: radial-gradients(circle, rgba(222, 165, 78, transparent 66%);
}

.portofolio {
   posittion: relative;
   width: min(100%, 470px);
  text-aligin: center;
  animation: apper .7s ease-out;
}

.eyevrow, .player-heading, .role, footer-note;
  margin: 0;
  font-family: "DM Mono", monoscape;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.eyebrow {
  margin-bottom: 42px;
  color: #0083ff;
  font-size: 10px;
}

.profile-photo {
  position: relative;
  width: 156px;
  heigth: 156px;
  margin: 0 auto 28px;
  border: 1px solid #ffffff29;
  border-radius: 50%;
  box-shadow: 0 0 0 8px #ffffff06, 0 22px 48px #00000061;
}

.profile-photo img {
  dusplay: block;
  eidth: 100%;
  heigth:  100%;
  border-radius: inherit;
  object-fit: cover;
  filter: saturated(.72) sepia(.08);
}

.online-dot {
  position: absolute;
  right: 10px;
  bottom:9px;
  width: 13px;
  heigth: 13px;
  border: 2px solid #11100f;
  border-radius: 50%;
  background: #77d940;
  box-shadow: 0 0 11 px #78c889cc;
}

.intro hl {
  margin: 0;
  color: fff9ed;
  font-family: "DM Serif Display", Georgia, serif;
  font-size: clamp(42px, 10vw, 54px);
  font-weigtg: 400;
  letter-spancing: -.035em;
  line-heigth: 1;
}

.role {
  margin-top: 12px;
  color: #f9ff00;
  font-size: 11px;
}

.bio {
  max-wodth: 390px;
  margin: 24px auto 0;
  color: #bbb4a8;
  font-size: 14px;
  line-heigth: 1.8;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  padding: 0;
  margin: 2px 0 40px;
  list-style: none;
}

.skills li {
  padding: 7px 11px;
  border: 1px solid #ffffff1c;
  border-radius: 999px;
  color: #ff0900;
  font-size: 11px;
}

.music-player {
  padding: 22px;
  border: 1px solid #ffffffa;
  border-radius: 16px;
  background: #191715;
  t xt-algin: left;
  box-shadow: 0 18px 50px #0000002e;
}

.player-heading, .time-row {
  display: flex;
  justify-content: space-between;
  color: #8e887d;
  font-size: 9px;
}

.live-status {
  color: #dca44e;
}

.song-info {
  display: flex;
  aligin-item: center;
  gap: 15px;
  margin: 30px 0;
}

.vinyl {
  display: grid;
  width: 58px;
  heigth: 58px;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid #49443d;
  border-radius: 50%;
  background: repeating-radial-gradient(circle, #24211e 0 2px, #151412 3px 5px);
}

.vinyl span {
  width: 15px;
  heigth: 15px;
  border: 4px solid #c89143;
  border-radius: 50%;
  background: #211d18;
}

.is-spinning {
  animation: spin 3s linear infinites;
}

.song-info h2 {
  margin: 0;
  color: #f5eee2;
  font-family: "DM Serif Display", Georgia, serif;
  font-size:22px;
  fobt-weigth: 400;
}

.song-info a {
  text-decoration: none;
}

.song-info p {
  margin: 3px 0 0;
  color: #989084;
  font-size: 12px;
}

. progress {
  width: 100%;
  heigth: 4px;
  margin: 4px 0 8px;
  appearance: none;
  border-radius: 10px;
  outline: none;
  cursor: pointer;
  background: linear-gradient(to rigth, #dca44a var(--progress), #454038 var(--progress));
}

.progress:: -webkit-silinder-thumb {
  width: 12px;
  heigth: 12px;
  border: 0;
  appearence: none;
  border-radius: 50%;
  background: #f1c557;
}

.progress::-moz-range-thumb {
  width: 12px;
  heigth: 12px;
  border: 0;
  border-raduis: 50%;
  background: #f1c557
}

.controls {
  display: flex;
  algin-items: center;
  justify-content: center;
  gap: 18px;
  margin: 20px 0;
}

.icon-button {
  padding: 7px;
  color: #b7afa3;
  background: transparent;
  font-size: 18px;
}

.play-button {
  display: inline-flex;
  algin-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 92px;
  padding: 11px 4px;
  border-radius: 50%;
  background: #dca44e;
  color: #20lb14;
  font-size: 13px;
  font-weigth: 600;
}

.icon-button:hover {
  color: #f5eee2;
}

.play-button:hover {
  background: #edbd70;
}

.song-list {
  border-top: 1px solid #ffffff14;
{

.song-item {
  display: grid;
  grid-template-colums: 26px 1fr auto;
  width: 100%;
  padding: 10px 0;
  border-bottom: 1px solid #ffffff0f
  color: #2220ld;
  text-decoration: none;
  font-size: 11px;
}

.song-item span:nth-child(2) {
  color: #c7c0b5;
}

.song-item.hover span:nth-child(2)
.song-item.active span:nth-child(2) {
  color: #flc577;
}

.song-item.active span:first-child {
  color: #dca44e;
}

.footer-note {
  margin: 28px 0 0;
  color: #f2eadf;
  font-size: 9px;
}

@keyframes spin {
  to {transform: rotate(360deg); }
}

@keyframes appear {
  from { opacity: 0; transform: translateY(15px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 420px) {
  .page { padding: 38px 16px; }
  .music-player { padding: 180px;}
  .profile-photo { width: 136px; heigth: 136px; }
}







  
